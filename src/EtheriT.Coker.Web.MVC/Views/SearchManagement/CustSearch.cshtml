@using DevExtreme.AspNet.Mvc
@using EtheriT.Coker.Application.Shared.Dto.Search
@using EtheriT.Coker.Web.MVC.Extensions
@using EtheriT.Coker.Web.MVC.Views.Shared.Components.Modal
@{
    ViewData["Title"] = "搜尋設定";
    var power = Context.GetPermission();
}
<script src="~/js/SearchManagement/CustSearch.min.js" asp-append-version="true"></script>
<div id="CustSearchSettings" data-create="@power.CanCreate.ToString().ToLowerInvariant()" data-update="@power.CanUpdate.ToString().ToLowerInvariant()" data-remove="@power.CanRemove.ToString().ToLowerInvariant()">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h1 class="fw-bold fs-3 mb-0">搜尋設定</h1>
        @if (power.CanCreate) { <button type="button" class="btn btn-primary" id="CustSearchAdd">新增自訂搜尋</button> }
    </div>
    <p class="text-muted mb-2">直接勾選預設搜尋。商品與文章為固定項目，自訂搜尋可混合設定範圍。</p>
    <div id="CustSearchMessage" class="alert alert-info py-2 d-none" role="status"></div>
    <div id="CustSearchList" class="card"><div class="card-body p-2">
        @(Html.DevExtreme().DataGrid<CuseSearchListDto>()
            .ID("CustSearchGrid")
            .DataSource(d => d.RemoteController().Key("Id").LoadUrl("/api/Search/GetAll").LoadMethod("Get").OnBeforeSend("custSearchGridBeforeSend").LoadParams(new { _site = Context.Request.Query["_site"].ToString() }))
            .RemoteOperations(true).ShowBorders(true).ColumnAutoWidth(true).WordWrapEnabled(true)
            .SearchPanel(s => s.Visible(true).Placeholder("搜尋名稱或範圍"))
            .Sorting(s => s.Mode(GridSortingMode.None)).Paging(p => p.PageSize(20))
            .Columns(c => {
                c.AddFor(x => x.IsSystem).Visible(false);
                c.AddFor(x => x.IsDefault).Caption("預設").Width(65).AllowSorting(false).CellTemplate(new JS("custSearchDefaultCell"));
                c.AddFor(x => x.Title).Caption("名稱");
                c.AddFor(x => x.ScopeSummary).Caption("搜尋範圍");
                c.AddFor(x => x.Visible).Caption("顯示").Width(65);
                c.AddFor(x => x.SerNO).Caption("排序").Width(110).AllowSorting(false).CellTemplate(new JS("custSearchOrderCell"));
                c.Add().Type(GridCommandColumnType.Buttons).Width(85).Buttons(b => {
                    b.Add().Icon("edit").Hint("檢視／編輯").Visible(new JS("custSearchCanEdit")).OnClick("custSearchEdit");
                    b.Add().Icon("trash").Hint("刪除").Visible(new JS("custSearchCanDelete")).OnClick("custSearchDelete");
                });
            }).OnContentReady("custSearchGridReady").OnDataErrorOccurred("custSearchLoadError"))
    </div></div>
    <div id="CustSearchEditor" class="card border-0 d-none">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="fw-bold fs-5 d-flex align-items-center">
                <button type="button" id="CustSearchBack" class="btn_back d-flex bg-transparent border-0 align-items-center" aria-label="返回搜尋列表" title="返回搜尋列表">
                    <span class="material-symbols-outlined" aria-hidden="true">keyboard_backspace</span>
                </button>
                <div class="lh-lg" id="CustSearchEditorTitle">編輯自訂搜尋</div>
            </div>
            <button type="submit" form="CustSearchForm" class="btn_done btn-primary border-0 px-3 py-1 text-white text-nowrap btn" id="CustSearchSave" disabled>儲　存</button>
        </div>
        <form id="CustSearchForm" class="card-body p-3">
            @Html.AntiForgeryToken()
            <fieldset id="CustSearchFields" disabled>
                <div class="row g-2 mb-2">
                    <div class="col-md-5"><label class="form-label mb-1" for="CustSearchTitle">名稱</label><input id="CustSearchTitle" class="form-control" maxlength="60" required /></div>
                    <div class="col-md-5"><label class="form-label mb-1" for="CustSearchPlaceholder">搜尋框提示文字</label><input id="CustSearchPlaceholder" class="form-control" maxlength="100" /></div>
                    <div class="col-md-2"><label class="form-label mb-1" for="CustSearchOrder">排序</label><input id="CustSearchOrder" type="number" min="0" max="2147483647" step="1" value="0" class="form-control" required /></div>
                    <div class="col-md-10"><label class="form-label mb-1" for="CustSearchDescription">描述</label><textarea id="CustSearchDescription" class="form-control" rows="1" maxlength="150"></textarea></div>
                    <div class="col-md-2 d-flex align-items-end pb-1"><label class="text-nowrap"><input id="CustSearchVisible" type="checkbox" class="form-check-input me-1" checked />顯示</label></div>
                </div>
                <div class="border-top pt-2">
                    <div class="text-muted mb-2">搜尋範圍可混合設定；勾選全部，或選擇指定標籤／選單。</div>
                    <div id="CustSearchProductScope" class="row gx-2 gy-1 align-items-center mb-2">
                        <div class="col-auto fw-bold text-nowrap">商品</div>
                        <div class="col-auto"><label class="text-nowrap"><input id="CustSearchAllProd" type="checkbox" class="form-check-input me-1" />全部</label></div>
                        <div class="col"><input id="CustSearchProductTags" type="button" class="form-control text-start text-truncate" value="選擇商品標籤…" aria-label="選擇商品標籤" data-bs-toggle="modal" data-bs-target="#TagModal" /></div>
                    </div>
                    <div id="CustSearchInactiveProduct" class="text-muted mb-2 d-none">
                        商品目前沒有可見資料，既有商品範圍已保留。
                        <button type="button" id="CustSearchRemoveProductScope" class="btn btn-link p-0">移除既有商品範圍</button>
                    </div>
                    <div class="row gx-2 gy-1 align-items-center mb-2">
                        <div class="col-auto fw-bold text-nowrap">文章</div>
                        <div class="col-auto"><label class="text-nowrap"><input id="CustSearchAllArticle" type="checkbox" class="form-check-input me-1" />全部</label></div>
                        <div class="col"><input id="CustSearchArticleTags" type="button" class="form-control text-start text-truncate" value="選擇文章標籤…" aria-label="選擇文章標籤" data-bs-toggle="modal" data-bs-target="#TagModal" /></div>
                    </div>
                    <div class="row gx-2 gy-1 align-items-center">
                        <div class="col-auto fw-bold text-nowrap">選單</div>
                        <div class="col-auto"><label class="text-nowrap"><input id="CustSearchAllMenu" type="checkbox" class="form-check-input me-1" />全部</label></div>
                        <div class="col"><div id="CustSearchMenus" aria-label="選擇選單"></div></div>
                    </div>
                </div>
            </fieldset>
        </form>
    </div>
</div>
@await Component.InvokeAsync(nameof(Modal), new { dispaly = "TagSelectModal" })
