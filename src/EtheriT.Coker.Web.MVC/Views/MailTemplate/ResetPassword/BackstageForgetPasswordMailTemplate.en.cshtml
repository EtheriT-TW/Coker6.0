@model EtheriT.Coker.Application.Shared.Dto.MailTemplate.BackstageForgetTemplateResultDto;
<style>
    body { font-family: Arial, sans-serif; line-height: 1.6; }
    .box { border: 1px solid #cccccc; padding: 12px; margin: 16px 0; }
    .label { font-weight: bold; width: 140px; vertical-align: top; }
    .action { margin: 16px 0; }
    .hint { color: #666666; font-size: 12px; }
</style>

<p>Hello @Model.Name,</p>
<p>We received a request to reset your Coker back-office password.</p>

<div class="box">
    <table>
        <tr>
            <td class="label">Account</td>
            <td>@Model.Account</td>
        </tr>
        <tr>
            <td class="label">Link expires at</td>
            <td>@Model.ExpireTime.ToString("yyyy/MM/dd HH:mm")</td>
        </tr>
    </table>
</div>

<p>Use the following link to set a new password:</p>
<div class="action"><a href="@Model.ResetPasswordUrl">Reset password</a></div>
<p>If the link is not clickable, copy and paste this URL into your browser:</p>
<p>@Model.ResetPasswordUrl</p>

<p class="hint">
    This single-use link expires at the time shown above.<br>
    If you did not request a password reset, ignore this email; your password will remain unchanged.<br>
    This is an automated message. Please do not reply.
</p>
