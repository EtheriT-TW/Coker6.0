@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var mvcUrl = Configuration["SystemLinks:MvcUrl"]?.TrimEnd('/') ?? "/";
    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coker Platform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,300,0,0" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/devextreme/dx.light.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="platform-shell">
        <aside class="platform-sidebar" id="platformSidebar">
            <a class="platform-brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark">C</span>
                <span>
                    <strong>Coker</strong>
                    <small>Customer Platform</small>
                </span>
            </a>

            <nav class="platform-nav" aria-label="主要選單">
                <span class="nav-caption">平台管理</span>
                <a class="platform-nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                    <span class="material-symbols-outlined">space_dashboard</span><span>總覽</span>
                </a>
                <a class="platform-nav-link @Active("Companies")" asp-controller="Companies" asp-action="Index">
                    <span class="material-symbols-outlined">domain</span><span>客戶資料</span>
                </a>
                <a class="platform-nav-link @Active("Websites")" asp-controller="Websites" asp-action="Index">
                    <span class="material-symbols-outlined">language</span><span>網站與站台</span>
                </a>
                <a class="platform-nav-link @Active("Licenses")" asp-controller="Licenses" asp-action="Index">
                    <span class="material-symbols-outlined">verified_user</span><span>版本與授權</span>
                </a>

                <span class="nav-caption nav-caption-spaced">營運</span>
                <a class="platform-nav-link @Active("Analytics")" asp-controller="Analytics" asp-action="Index">
                    <span class="material-symbols-outlined">monitoring</span><span>營運分析</span>
                </a>
                <a class="platform-nav-link @Active("SystemSettings")" asp-controller="SystemSettings" asp-action="Index">
                    <span class="material-symbols-outlined">settings</span><span>系統設定</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <span class="environment-dot"></span>
                <span>Platform 管理系統</span>
            </div>
        </aside>

        <button class="sidebar-backdrop" id="sidebarBackdrop" aria-label="關閉選單"></button>

        <div class="platform-main">
            <header class="platform-header">
                <button class="icon-button sidebar-toggle" id="sidebarToggle" type="button" aria-label="開啟選單">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <div class="header-context">
                    <span class="header-eyebrow">客戶管理平台</span>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <nav class="header-actions" aria-label="系統捷徑">
                    <a class="icon-button" href="@($"{mvcUrl}/Welcome")" title="返回網站管理後台" aria-label="返回網站管理後台">
                        <span class="material-symbols-outlined">apps</span>
                    </a>
                    <a class="icon-button" asp-controller="Dashboard" asp-action="Index" title="Platform 首頁" aria-label="Platform 首頁">
                        <span class="material-symbols-outlined">home</span>
                    </a>
                    <span class="header-divider"></span>
                    <div class="account-chip">
                        <span class="account-avatar material-symbols-outlined">person</span>
                        <span class="account-copy"><small>系統管理員</small><strong>@(User.Identity?.Name ?? "-")</strong></span>
                    </div>
                </nav>
            </header>

            <main class="platform-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/localization/dx.messages.zh-tw.js"></script>
    <script>
        DevExpress.localization.locale("zh-tw");
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
