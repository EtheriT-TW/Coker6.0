@{
    ViewData["Title"] = "Dashboard";
}
<script src="~/js/Dashboard/Index.min.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/Dashboard/index.min.css" asp-append-version="true" />

<div class="container-fluid py-4 dashboard">
    <div class="row g-4 dashboard-kpis dashboard-system-kpis">
        <div class="col-12 col-md-6 col-xl">
            <div class="card dashboard-kpi h-100">
                <div class="card-header p-3 pt-2">
                    <div class="icon icon-lg icon-shape bg-gradient-warning shadow-dark text-center border-radius-xl mt-n4 position-absolute">
                        <i class="material-symbols-outlined opacity-10">storage</i>
                    </div>
                    <div class="text-end pt-1">
                        <p class="text-sm mb-0">使用空間</p>
                        <h4 class="mb-0 storage-size">--</h4>
                    </div>
                </div>
                <hr class="dark horizontal my-0" />
                <div class="card-footer p-3">
                    <p class="mb-0 text-sm">最後更新：<span class="text-success font-weight-bolder storage-updated-at">載入中</span></p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl">
            <div class="card dashboard-kpi h-100">
                <div class="card-header p-3 pt-2">
                    <div class="icon icon-lg icon-shape bg-gradient-info shadow-primary text-center border-radius-xl mt-n4 position-absolute">
                        <i class="material-symbols-outlined opacity-10">monitoring</i>
                    </div>
                    <div class="text-end pt-1">
                        <p class="text-sm mb-0">本月流量</p>
                        <h4 class="mb-0 month-flow-size">--</h4>
                    </div>
                </div>
                <hr class="dark horizontal my-0" />
                <div class="card-footer p-3">
                    <p class="mb-0 text-sm">統計區間：<span class="text-success font-weight-bolder month-flow-range">載入中</span></p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl">
            <div class="card dashboard-kpi h-100">
                <div class="card-header p-3 pt-2">
                    <div class="icon icon-lg icon-shape bg-gradient-success shadow-success text-center border-radius-xl mt-n4 position-absolute">
                        <i class="material-symbols-outlined opacity-10">groups</i>
                    </div>
                    <div class="text-end pt-1">
                        <p class="text-sm mb-0">在線訪客</p>
                        <h4 class="mb-0 online-visitor-count">--</h4>
                    </div>
                </div>
                <hr class="dark horizontal my-0" />
                <div class="card-footer p-3">
                    <p class="mb-0 text-sm">最近 2 分鐘內仍在瀏覽網站，每 30 秒更新</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl dashboard-contact-kpi" hidden>
            <a class="text-decoration-none text-reset" href="/ContentManagement/ContactUs">
                <div class="card dashboard-kpi h-100">
                    <div class="card-header p-3 pt-2">
                        <div class="icon icon-lg icon-shape bg-gradient-danger shadow-danger text-center border-radius-xl mt-n4 position-absolute">
                            <i class="material-symbols-outlined opacity-10">mark_email_unread</i>
                        </div>
                        <div class="text-end pt-1">
                            <p class="text-sm mb-0">待處理表單</p>
                            <h4 class="mb-0 pending-contact-count">--</h4>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0" />
                    <div class="card-footer p-3">
                        <p class="mb-0 text-sm">尚未開始處理的表單資料</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-4 mt-1 dashboard-revenue-kpis" hidden>
        <div class="col-12 col-lg-6">
            <div class="card dashboard-revenue-card h-100">
                <div class="card-body p-4">
                    <div class="dashboard-revenue-heading">
                        <div>
                            <p class="text-sm text-secondary mb-1">本日有效訂單金額</p>
                            <h3 class="mb-1 today-order-amount">NT$ --</h3>
                            <span class="text-xs text-secondary">
                                已付款相關訂單 <strong class="today-paid-order-count text-dark">--</strong> 筆
                            </span>
                        </div>
                        <div class="dashboard-revenue-icon bg-gradient-success">
                            <i class="material-symbols-outlined">payments</i>
                        </div>
                    </div>
                    <div class="dashboard-revenue-comparison mt-3">
                        <span class="text-xs text-secondary">
                            昨日 <strong class="yesterday-order-amount text-dark">NT$ --</strong>
                        </span>
                        <span class="dashboard-change-badge today-order-change">--</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card dashboard-revenue-card h-100">
                <div class="card-body p-4">
                    <div class="dashboard-revenue-heading">
                        <div>
                            <p class="text-sm text-secondary mb-1">本月有效訂單金額</p>
                            <h3 class="mb-1 month-order-amount">NT$ --</h3>
                            <span class="text-xs text-secondary">
                                已付款相關訂單 <strong class="month-paid-order-count text-dark">--</strong> 筆
                            </span>
                        </div>
                        <div class="dashboard-revenue-icon bg-gradient-info">
                            <i class="material-symbols-outlined">account_balance_wallet</i>
                        </div>
                    </div>
                    <div class="dashboard-revenue-comparison mt-3">
                        <span class="text-xs text-secondary">
                            上月同期 <strong class="previous-month-order-amount text-dark">NT$ --</strong>
                        </span>
                        <span class="dashboard-change-badge month-order-change">--</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1 dashboard-commerce-kpis" hidden>
        <div class="col-6 col-md-4 col-xl-2 dashboard-order-kpi">
            <a class="text-decoration-none text-reset" href="/OrderManagement">
                <div class="card dashboard-kpi dashboard-commerce-kpi h-100">
                    <div class="card-header p-3">
                        <div class="dashboard-commerce-icon bg-gradient-warning">
                            <i class="material-symbols-outlined">assignment_late</i>
                        </div>
                        <p class="text-sm text-secondary mb-1 mt-3">待確認訂單</p>
                        <h4 class="mb-0 pending-confirmation-order-count">--</h4>
                    </div>
                    <div class="card-footer px-3 py-2">
                        <span class="text-xs text-secondary">需要優先確認</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2 dashboard-order-kpi">
            <a class="text-decoration-none text-reset" href="/OrderManagement">
                <div class="card dashboard-kpi dashboard-commerce-kpi h-100">
                    <div class="card-header p-3">
                        <div class="dashboard-commerce-icon bg-gradient-danger">
                            <i class="material-symbols-outlined">payments</i>
                        </div>
                        <p class="text-sm text-secondary mb-1 mt-3">待付款訂單</p>
                        <h4 class="mb-0 pending-payment-order-count">--</h4>
                    </div>
                    <div class="card-footer px-3 py-2">
                        <span class="text-xs text-secondary">等待付款完成</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2 dashboard-order-kpi">
            <a class="text-decoration-none text-reset" href="/OrderManagement">
                <div class="card dashboard-kpi dashboard-commerce-kpi h-100">
                    <div class="card-header p-3">
                        <div class="dashboard-commerce-icon bg-gradient-info">
                            <i class="material-symbols-outlined">inventory_2</i>
                        </div>
                        <p class="text-sm text-secondary mb-1 mt-3">待出貨訂單</p>
                        <h4 class="mb-0 awaiting-shipment-order-count">--</h4>
                    </div>
                    <div class="card-footer px-3 py-2">
                        <span class="text-xs text-secondary">已付款待處理</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2 dashboard-order-kpi">
            <a class="text-decoration-none text-reset" href="/OrderManagement">
                <div class="card dashboard-kpi dashboard-commerce-kpi h-100">
                    <div class="card-header p-3">
                        <div class="dashboard-commerce-icon bg-gradient-success">
                            <i class="material-symbols-outlined">local_shipping</i>
                        </div>
                        <p class="text-sm text-secondary mb-1 mt-3">配送中訂單</p>
                        <h4 class="mb-0 shipping-order-count">--</h4>
                    </div>
                    <div class="card-footer px-3 py-2">
                        <span class="text-xs text-secondary">已出貨未完成</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2 dashboard-product-kpi">
            <a class="text-decoration-none text-reset" href="/ProductManagement/SaleQuantityStaging">
                <div class="card dashboard-kpi dashboard-commerce-kpi h-100">
                    <div class="card-header p-3">
                        <div class="dashboard-commerce-icon bg-gradient-danger">
                            <i class="material-symbols-outlined">inventory</i>
                        </div>
                        <p class="text-sm text-secondary mb-1 mt-3">庫存警示規格</p>
                        <h4 class="mb-0 low-stock-count">--</h4>
                    </div>
                    <div class="card-footer px-3 py-2">
                        <span class="text-xs text-secondary">已達安全庫存量</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2 dashboard-product-kpi">
            <a class="text-decoration-none text-reset" href="/ProductManagement/ProductList">
                <div class="card dashboard-kpi dashboard-commerce-kpi h-100">
                    <div class="card-header p-3">
                        <div class="dashboard-commerce-icon bg-gradient-dark">
                            <i class="material-symbols-outlined">production_quantity_limits</i>
                        </div>
                        <p class="text-sm text-secondary mb-1 mt-3">已售完商品</p>
                        <h4 class="mb-0 sold-out-product-count">--</h4>
                    </div>
                    <div class="card-footer px-3 py-2">
                        <span class="text-xs text-secondary">目前前台售完</span>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-4 mt-1 dashboard-order-trend-section" hidden>
        <div class="col-12 col-xl-8 dashboard-order-insight-column dashboard-order-trend-column" hidden>
            <div class="card dashboard-panel dashboard-order-trend-panel h-100">
                <div class="card-header dashboard-card-header pb-0">
                    <div class="dashboard-heading-row">
                        <div>
                            <h6 class="mb-1 order-trend-title">近 30 天有效訂單趨勢</h6>
                            <p class="text-sm text-secondary mb-0">排除已取消、付款失敗及暫存訂單・金額包含商品小計與運費</p>
                        </div>
                        <div class="dashboard-traffic-actions">
                            <span class="text-xs text-secondary order-trend-range"></span>
                            <div class="dashboard-filter-row" role="group" aria-label="有效訂單趨勢區間">
                                <button type="button" class="dashboard-filter-button order-trend-range-button" data-days="7">近七天</button>
                                <button type="button" class="dashboard-filter-button order-trend-range-button is-active" data-days="30">近 30 天</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <div class="dashboard-order-trend-chart">
                        <div id="dashboard-order-trend-chart"></div>
                    </div>
                    <div class="dashboard-loading order-trend-loading">正在載入訂單趨勢…</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-4 dashboard-order-insight-column dashboard-recent-orders-column" hidden>
            <div class="card dashboard-panel dashboard-order-trend-panel h-100">
                <div class="card-header dashboard-card-header pb-0">
                    <div class="dashboard-heading-row">
                        <div>
                            <h6 class="mb-1">最近未完成訂單</h6>
                            <p class="text-sm text-secondary mb-0">最新 5 筆仍需追蹤的訂單</p>
                        </div>
                        <a class="btn btn-sm btn-outline-primary mb-0" href="/OrderManagement">查看全部</a>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <div class="dashboard-recent-order-list"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1 dashboard-traffic-section">
        <div class="col-12 col-xl-8">
            <div class="card dashboard-panel h-100">
                <div class="card-header dashboard-card-header pb-0">
                    <div class="dashboard-heading-row">
                        <div>
                            <h6 class="mb-1 traffic-title">最近 7 天瀏覽趨勢</h6>
                            <p class="text-sm text-secondary mb-0">有效瀏覽人次與不重複訪客</p>
                        </div>
                        <div class="dashboard-traffic-actions">
                            <span class="text-xs text-secondary traffic-updated-at"></span>
                            <div class="dashboard-filter-row" role="group" aria-label="瀏覽趨勢統計區間">
                                <button type="button" class="dashboard-filter-button traffic-range-button" data-days="1">今日</button>
                                <button type="button" class="dashboard-filter-button traffic-range-button is-active" data-days="7">近七天</button>
                                <button type="button" class="dashboard-filter-button traffic-range-button" data-days="30">近 30 天</button>
                                <button type="button" class="dashboard-filter-button traffic-custom-toggle">自訂區間</button>
                            </div>
                        </div>
                    </div>
                    <div class="dashboard-custom-range" hidden>
                        <label>
                            <span>開始日期</span>
                            <input type="date" class="form-control form-control-sm traffic-start-date" />
                        </label>
                        <span class="dashboard-date-separator">至</span>
                        <label>
                            <span>結束日期</span>
                            <input type="date" class="form-control form-control-sm traffic-end-date" />
                        </label>
                        <button type="button" class="btn btn-sm btn-primary mb-0 traffic-custom-apply">套用</button>
                        <span class="text-xs text-danger traffic-range-error" role="alert"></span>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <div class="dashboard-chart">
                        <div id="dashboard-traffic-chart"></div>
                    </div>
                    <div class="dashboard-loading traffic-loading">正在載入流量資料…</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card dashboard-panel h-100">
                <div class="card-header dashboard-card-header pb-0">
                    <div class="dashboard-heading-row">
                        <div>
                            <h6 class="mb-1 popular-pages-title">本日熱門頁面</h6>
                            <p class="text-sm text-secondary mb-0">依有效瀏覽次數排序，最多顯示 5 筆</p>
                        </div>
                        <span class="material-symbols-outlined text-info">local_fire_department</span>
                    </div>
                    <div class="dashboard-filter-row" role="group" aria-label="熱門頁面統計區間">
                        <button type="button" class="dashboard-filter-button popular-period-button is-active" data-period="today" data-title="本日">本日</button>
                        <button type="button" class="dashboard-filter-button popular-period-button" data-period="week" data-title="近七天">近七天</button>
                        <button type="button" class="dashboard-filter-button popular-period-button" data-period="month" data-title="本月">本月</button>
                        <button type="button" class="dashboard-filter-button popular-period-button" data-period="year" data-title="今年">今年</button>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <div class="popular-page-list"></div>
                    <div class="dashboard-loading popular-pages-loading">正在載入熱門頁面…</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1 dashboard-heatmap-section">
        <div class="col-12 col-xl-8">
            <div class="card dashboard-panel dashboard-heatmap-panel h-100">
                <div class="card-header dashboard-card-header pb-0">
                    <div class="dashboard-heading-row">
                        <div>
                            <h6 class="mb-1">訪客活躍時段</h6>
                            <p class="text-sm text-secondary mb-0">查看一週中哪些時段的瀏覽人數較多，顏色越深代表越多人瀏覽</p>
                        </div>
                        <div class="dashboard-traffic-actions">
                            <span class="text-xs text-secondary heatmap-summary"></span>
                            <div class="dashboard-filter-row" role="group" aria-label="訪客活躍時段統計區間">
                                <button type="button" class="dashboard-filter-button heatmap-range-button" data-days="7">近七天</button>
                                <button type="button" class="dashboard-filter-button heatmap-range-button is-active" data-days="30">近 30 天</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <div class="dashboard-heatmap-content">
                        <div class="dashboard-heatmap-scroll">
                            <div id="dashboard-traffic-heatmap"></div>
                        </div>
                        <div class="dashboard-heatmap-legend" aria-label="熱度色階">
                            <span>較少</span>
                            <span class="dashboard-heatmap-gradient"></span>
                            <span>較多</span>
                            <span class="dashboard-heatmap-unit">平均訪客人數／小時</span>
                        </div>
                    </div>
                    <div class="dashboard-loading heatmap-loading">正在載入訪客時段資料…</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card dashboard-panel h-100">
                <div class="card-header dashboard-card-header pb-0">
                    <div class="dashboard-heading-row">
                        <div>
                            <h6 class="mb-1">瀏覽人數最高時段</h6>
                            <p class="text-sm text-secondary mb-0">依平均訪客人數排序，列出最高的 5 個時段</p>
                        </div>
                        <span class="material-symbols-outlined text-info">schedule</span>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <div class="dashboard-recommended-slots">
                        <div class="dashboard-loading">正在載入熱門瀏覽時段…</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1 dashboard-contact-sections" hidden>
        <div class="col-12 col-xl-7">
            <div class="card dashboard-panel h-100">
                <div class="card-header d-flex align-items-center justify-content-between pb-0">
                    <div>
                        <h6 class="mb-1">表單處理狀態</h6>
                        <p class="text-sm text-secondary mb-0">依實際表單位置分組</p>
                    </div>
                    <a class="btn btn-sm btn-outline-primary mb-0" href="/ContentManagement/ContactUs">查看全部</a>
                </div>
                <div class="card-body pt-3">
                    <div class="contact-form-summary"></div>
                    <div class="dashboard-loading contact-summary-loading">正在載入表單統計…</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card dashboard-panel h-100">
                <div class="card-header d-flex align-items-center justify-content-between pb-0">
                    <div>
                        <h6 class="mb-1">最近提交資料</h6>
                        <p class="text-sm text-secondary mb-0">顯示最近 5 筆表單資料</p>
                    </div>
                    <span class="material-symbols-outlined text-success">schedule</span>
                </div>
                <div class="card-body pt-3">
                    <div class="recent-contact-list"></div>
                    <div class="dashboard-loading recent-contacts-loading">正在載入最近提交…</div>
                </div>
            </div>
        </div>
    </div>
</div>
