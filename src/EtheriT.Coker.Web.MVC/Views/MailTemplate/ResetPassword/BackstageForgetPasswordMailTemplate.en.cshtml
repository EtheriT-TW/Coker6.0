@model EtheriT.Coker.Application.Shared.Dto.MailTemplate.BackstageForgetTemplateResultDto;
<style>
    body { font-family: Arial, sans-serif; line-height: 1.6; }
    .box { border: 1px solid #cccccc; padding: 12px; margin: 16px 0; }
    .label { font-weight: bold; width: 140px; vertical-align: top; }
    .action { margin: 16px 0; }
    .hint { color: #666666; font-size: 12px; }
</style>

<p>Hello @Model.Name,</p>
@if (Model.IsPlatformInvitation)
{
    <p>You have been invited to become a Coker administrator. Verify this email address and set your account and password.</p>
    <p>Administrative access remains disabled until a Platform administrator approves the invitation.</p>
}
else if (Model.IsAccountActivation)
{
    <p>You have been invited to activate a Coker back-office account. Set your account and password to continue.</p>
}
else
{
    <p>We received a request to reset your Coker back-office password.</p>
}

<div class="box">
    <table>
        <tr>
            <td class="label">Account</td>
            <td>@Model.Account</td>
        </tr>
        <tr>
            <td class="label">Link expires at</td>
            <td>@Model.ExpireTime.ToString("yyyy/MM/dd HH:mm")</td>
        </tr>
    </table>
</div>

<p>Use the following link to @(Model.IsAccountActivation ? "complete account setup" : "set a new password"):</p>
<div class="action"><a href="@Model.ResetPasswordUrl">@(Model.IsAccountActivation ? "Set account and password" : "Reset password")</a></div>
<p>If the link is not clickable, copy and paste this URL into your browser:</p>
<p>@Model.ResetPasswordUrl</p>

<p class="hint">
    This single-use link expires at the time shown above.<br>
    If you do not recognize this invitation or did not request a password reset, ignore this email.<br>
    This is an automated message. Please do not reply.
</p>
