@using DevExtreme.AspNet.Mvc
@using EtheriT.Coker.Application.Shared.Dto.Freight
@using EtheriT.Coker.Application.Shared.Dto.Recipients
@using EtheriT.Coker.Application.Shared.Dto.ThirdParty;
@using EtheriT.Coker.Web.Public.Models
@using EtheriT.Coker.Application.Shared.i18n;
@using System.Web
@model PageViewModel
@{
    var invoiceMode = ViewBag.InvoiceMode as string ?? "EnabledInvoice";
}
<script nonce="@ViewBag.Nonce">
    const MinOrderForRedemption = @Json.Serialize(ViewBag.MinOrderForRedemption ?? 0);
    const MaxRedemptionPercent = @Json.Serialize(ViewBag.MaxRedemptionPercent ?? 0);
    const MaximumDiscount = @Json.Serialize(ViewBag.MaximumDiscount);
    const MinOrderForEarnPoints = @Json.Serialize(ViewBag.MinOrderForEarnPoints ?? 0);
    const RewardRatePercent = @Json.Serialize(ViewBag.RewardRatePercent ?? 0);
    const RewardCalculationType = @Json.Serialize(ViewBag.RewardCalculationType ?? 1);
    const RewardFixedPoints = @Json.Serialize(ViewBag.RewardFixedPoints ?? 0);
    const RewardFixedPointsCumulative = @Json.Serialize(ViewBag.RewardFixedPointsCumulative ?? true);
</script>
@section Styles {
    <link rel="stylesheet" href="~/css/Page/ShoppingCart.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Payment/TwqrPayment.min.css" asp-append-version="true" />
}
@Html.AntiForgeryToken()
<!-- Modal -->
<div id="RecipientModal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 id="staticBackdropLabel" class="modal-title fw-bold">@L.get("CkRecipientModalTitle")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div id="RecipientsListLoading" class="py-4 text-muted" role="status">@L.get("CkRecipientLoading")</div>
                <div id="RecipientsListError" class="recipient-list-message d-none" role="alert">
                    <div class="fw-bold mb-2">@L.get("CkRecipientLoadFailed")</div>
                    <div class="small mb-3 recipient-list-error-detail"></div>
                    <button type="button" class="recipient-modal-button recipient-modal-button-secondary btn_recipient_retry">@L.get("CkReload")</button>
                </div>
                <div id="RecipientsListEmpty" class="py-4 d-none">
                    <div class="recipient-empty-icon" aria-hidden="true">＋</div>
                    <div class="recipient-empty-title fw-bold fs-5 mb-2">@L.get("CkRecipientEmpty")</div>
                    <div class="recipient-empty-description small text-muted mb-4">@L.get("CkRecipientEmptyHint")</div>
                    <button type="button" class="recipient-modal-button recipient-modal-button-primary btn_recipient_new" data-bs-dismiss="modal">@L.get("CkRecipientAddFirst")</button>
                </div>
                <div id="RecipientsCardList" class="recipient-card-list text-start"></div>
            </div>
            <div class="modal-footer justify-content-between border-0">
                <button type="button" class="recipient-modal-button recipient-modal-button-secondary" data-bs-dismiss="modal">@L.get("Cancel")</button>
                <button type="button" class="recipient-modal-button recipient-modal-button-primary btn_recipient_new recipient-footer-new d-none" data-bs-dismiss="modal">＋ @L.get("CkRecipientAdd")</button>
            </div>
        </div>
    </div>
</div>
@if (Model.PageData != null && !string.IsNullOrWhiteSpace(Model.PageData.Html))
{
    <Content id="main">
        <coker-safe-html content="@Model.SafeHtml"
                         css="@Model.SafeCss"
                         website-id="@Model.HtmlSanitizeWebsiteId"
                         source-type="@Model.HtmlSanitizeSourceType"
                         source-id="@Model.HtmlSanitizeSourceId"
                         content-key="@Model.HtmlSanitizeContentKey"
                         sanitize-policy="@Model.HtmlSanitizePolicy"
                         parent-content="@Model.ParentSafeHtml"
                         parent-css="@Model.ParentSafeCss"
                         parent-source-id="@Model.ParentHtmlSanitizeSourceId"></coker-safe-html>
    </Content>
}
<div class="history container my-4 d-flex flex-wrap justify-content-center justify-content-md-end d-none">
    <a class="bg-white text-center m-1 py-2" href="/@ViewData["OrgName"]/Favorites">
        <div>@L.get("CkFavoriteCount")<span class="fw-bold">20</span>@L.get("CartItemUnit")</div>
    </a>
    <a href="" class="bg-white text-center m-1 py-2">
        <div>@L.get("CkPurchasedCount")<span class="fw-bold">3</span>@L.get("CartItemUnit")</div>
    </a>
</div>
<div id="BuyStepSwiper" class="container pt-3 pb-4 mt-2 position-relative">
    @if (ViewBag.LoginEnable != null && ViewBag.LoginEnable && !ViewBag.isLogin)
    {
        <div id="memberLogin" class="container my-5">
            <div class="rounded-1 px-3 py-4 bg-white d-flex align-items-center justify-content-center justify-content-sm-start">
                <div class="member-login-message">@L.get("CkLoginHint")</div>
                <button class="btn_call_login bg-transparent rounded-1 ms-0 ms-sm-3">@L.get("CkMemberLogin")</button>
            </div>
        </div>
    }

    <div class="swiper_pagination">
        <div class="swiper_pagination_buystep"></div>

        <div class="step_name d-flex text-center justify-content-between p-0">
            <div class="">@L.get("CartStepCart")</div>
            <div class="">@L.get("CartStepInfo")</div>
            <div class="">@L.get("CartStepDone")</div>
        </div>
    </div>

    <div class="swiper shadow-lg mt-3">
        <div class="swiper-wrapper">
            <div id="Step1" class="card text-center swiper-slide">
                <div class="card-header px-3 py-2 d-flex align-items-center justify-content-between">
                    <div class="fs-5 my-2">@L.get("CartDetailTitle")</div>
                </div>

                <div class="card-body pt-5 d-none">
                    <div class="list_title row d-none d-lg-flex">
                        <div class="col-6 text-start">@L.get("CartColProduct")</div>
                        <div class="col-2">@L.get("CartColUnitPrice")</div>
                        <div class="col-2">@L.get("Quantity")</div>
                        <div class="col-2">@L.get("CartColSubtotal")</div>
                    </div>
                    <template id="Template_Cart_Group">
                        <li class="purchase_group border-top py-2" data-group-id="">
                            <div class="group_header mb-2">
                                <label class="form-check d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2 js-group-check">
                                    <span class="group_title fw-bold" data-field="title"></span>
                                    <span class="badge bg-secondary ms-2" data-field="count">@L.get("CartItemCount", 0)</span>
                                </label>
                                <div class="text-muted small" data-field="describe"></div>
                            </div>

                            <ul class="group_items list-unstyled mb-0"></ul>

                            <div class="group_footer mt-2 pt-2 d-flex justify-content-between align-items-center">
                                <small class="text-muted">@L.get("CartSelectedPrefix") <span class="js-selected-count">0</span> @L.get("CartItemUnit")</small>
                                <div>
                                    <span class="fw-bold">@L.get("CartSubtotalLabel")</span>
                                    <span class="js-group-subtotal price red_text fw-bold" data-subtotal="0">0</span>
                                </div>
                            </div>
                        </li>
                    </template>


                    <template id="Template_Cart_Details">
                        <li class="purchase_item row border-bottom py-2 align-items-lg-center position-relative" data-scid="">
                            <div class="image col-lg-6 col-sm-2 col-4 row gx-0">
                                <div class="cart-product-media d-flex align-content-center pro_link col-lg-2 col-12 me-3">
                                    <input type="checkbox" name="buyItems" class="form-check-input me-2" />
                                    <label>
                                        <img data-key="imagePath" class="pro_image img-fluid" alt="@L.get("CartProductAlt")" src="">
                                    </label>
                                </div>
                                <a data-key="link" class="pro_link col text-start overflow-hidden" href="" target="_blank" rel="noopener noreferrer">
                                    <div class="content d-lg-block d-none">
                                        <div data-key="title" class="pro_name single_line fw-bold"></div>
                                        <div class="pro_detail d-flex flex-wrap">
                                            <div data-key="spec" class="pro_specification pe-3"></div>
                                        </div>
                                        <div data-key="freight" class="fixedFreight"></div>
                                        <div class="js-cart-item-message d-none d-lg-block text-start"></div>
                                    </div>
                                </a>
                            </div>
                            <div class="nostock text-start col-sm-6 col d-none">
                                <div data-key="title" class="pro_name d-lg-none single_line fw-bold"></div>
                                <div class="pro_detail d-lg-none d-flex flex-wrap">
                                    <div data-key="spec" class="pro_specification pe-3"></div>
                                </div>
                                <div class="js-unavailable-message h5 fw-bold red_text">@L.get("CartItemUnavailable")</div>
                            </div>
                            <div class="content col-sm-6 col row gx-0 overflow-hidden">
                                <a data-key="link" class="pro_link" href="" title="@L.get("LinkTo", L.get("CartProductAlt"))" target="_blank" rel="noopener noreferrer">
                                    <div class="d-lg-none d-block text-start">
                                        <div data-key="title" class="pro_name single_line fw-bold"></div>
                                        <div class="pro_detail d-flex flex-wrap">
                                            <div data-key="spec" class="pro_specification pe-3"></div>
                                            @*<div class="pro_instructions single_line"></div>*@
                                        </div>
                                        <div class="js-cart-item-message d-lg-none text-start"></div>
                                    </div>
                                </a>

                                <div class="cart-item-price col-12 col-lg-4 fw-bold align-self-center text-start text-lg-center" aria-label="@L.get("CartColUnitPrice")" data-label="@L.get("CartColUnitPrice")" data-label-colon="@L.get("CartColUnitPrice")@L.get("CkColon")">
                                    @* 劃線由 Default_Site.css 的 .pro_old_unit 背景漸層繪製 *@
                                    <div data-key="oldPrice" data-type="price" class="pro_old_unit fw-light d-none"></div>
                                    <div data-key="price" data-type="price" class="pro_unit cart-price-block">
                                        <div class="cart-price-main"></div>
                                        <div class="cart-price-bonus d-none"></div>
                                    </div>
                                </div>

                                <div class="counter_input col-12 col-lg-4 d-flex justify-content-start justify-content-lg-center align-items-center">
                                    <button class="btn_count_minus bg-white border-end-0">
                                        <i class="fa-solid fa-minus"></i>
                                        <span class="d-none">@L.get("Decrease")</span>
                                    </button>
                                    <label class="d-none" for="quantityInput1">@L.get("Quantity")</label>
                                    <input data-key="quantity" id="quantityInput1" class="pro_quantity text-center py-1" type="number" name="counter" value="">

                                    <button class="btn_count_plus bg-white border-start-0">
                                        <i class="fa-solid fa-plus"></i>
                                        <span class="d-none">@L.get("Increase")</span>
                                    </button>
                                </div>

                                <div data-key="subtotal" data-type="price" class="pro_subtotal col-4 fw-bold fs-5 d-none cart-price-block" data-subtotal="" aria-label="@L.get("CartColSubtotal")" data-label="@L.get("CartColSubtotal")" data-label-colon="@L.get("CartColSubtotal")@L.get("CkColon")">
                                    <div class="cart-price-main"></div>
                                    <div class="cart-price-bonus d-none"></div>
                                </div>
                            </div>

                            <div class="btn_side_icon position-absolute d-flex flex-column top-50 translate-middle-y end-0 p-2">

                                @if (ViewBag.LoginEnable)
                                {
                                    @if (ViewBag.isLogin)
                                    {
                                        <span class="d-inline-block favorites" tabindex="0" data-bs-toggle="popover" data-bs-placement="right" data-bs-trigger="hover focus" data-bs-content="@L.get("CartToggleFavorite")">
                                            <button class="btn_move_to_favorites bg-transparent border-0" type="button">
                                                <i class="fa-regular fa-heart text-danger"></i>
                                                <span class="d-none">@L.get("CartToggleFavorite")</span>
                                            </button>
                                        </span>
                                    }
                                }
                                <span class="d-inline-block" tabindex="0" data-bs-toggle="popover" data-bs-placement="right" data-bs-trigger="hover focus" data-bs-content="@L.get("CartRemoveItem")">
                                    <button class="btn_remove_pro bg-transparent border-0" type="button">
                                        <i class="fa-regular fa-trash-can"></i>
                                        <span class="d-none">@L.get("CartRemoveItem")</span>
                                    </button>
                                </span>
                            </div>
                        </li>
                    </template>
                    <ul class="purchase_list ps-4 pe-5"></ul>
                    <section id="CartMarketingRewards" class="cart-marketing-rewards d-none" aria-live="polite">
                        <div class="cart-marketing-heading">
                            <div>
                                <span class="cart-marketing-kicker">@L.get("CartMktKicker")</span>
                                <h3 class="cart-marketing-title">@L.get("CartMktTitle")</h3>
                            </div>
                            <span class="cart-marketing-selected-summary"></span>
                        </div>
                        <div class="cart-marketing-campaign-list"></div>
                    </section>
                    <div class="modal fade" id="CartProductAddOnModal" tabindex="-1" aria-labelledby="CartProductAddOnModalTitle" aria-hidden="true">
                        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                            <div class="modal-content cart-addon-modal-content">
                                <div class="modal-header">
                                    <div>
                                        <span class="cart-marketing-kicker">@L.get("CartAddOnModalKicker")</span>
                                        <h3 class="modal-title fs-5" id="CartProductAddOnModalTitle">@L.get("CartAddOnGift")</h3>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L.get("CloseWindow")"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="cart-addon-modal-campaigns"></div>
                                </div>
                                <div class="modal-footer cart-addon-modal-footer">
                                    <span class="cart-addon-modal-summary me-auto"></span>
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L.get("Cancel")</button>
                                    <button type="button" class="btn btn-danger js-save-cart-addons">@L.get("CartAddOnSave")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <partial name="_ProductRewardPreview" />
                    <div class="cart-summary-section">
                        <div class="cart-summary-gap" aria-hidden="true"></div>
                        <div class="priceline priceline-step1 pe-lg-5 col-12 col-lg-7 offset-lg-5">
                            <div class="summary-main-row generalProductAmountLine d-none">
                                <div class="summary-label">@L.get("CartGeneralAmount")</div>
                                <div class="summary-amount generalProductAmount price"></div>
                            </div>

                            <div class="summary-main-row addOnProductAmountLine d-none">
                                <div class="summary-label">@L.get("CartAddOnAmount")</div>
                                <div class="summary-amount addOnProductAmount price"></div>
                            </div>

                            <div class="summary-main-row productAmountLine">
                                <div class="summary-label">@L.get("CartProductAmount")</div>
                                <div class="summary-amount dual-price">
                                    <span class="bonus-part"><span class="bonus"></span>@L.get("CartBonusPointUnit")</span>
                                    <span class="plus-sign">+</span>
                                    <span class="cash-part subtotal price"></span>
                                </div>
                            </div>

                            <div class="marketingDiscountLines d-none"></div>

                            <div class="summary-main-row bonusDiscionLine d-none">
                                <div class="summary-label">@L.get("CartBonusDiscount")</div>
                                <div class="summary-amount bonusDiscion price-negative"></div>
                            </div>

                            <div class="summary-note-row bonusRuleLine d-none">
                                <div class="summary-note-value bonusRedeemRuleText"></div>
                                <div class="summary-note-label"></div>
                            </div>

                            <div class="summary-panel">
                                <div class="summary-main-row bonusUseTotalLine d-none">
                                    <div class="summary-label">@L.get("CartBonusUsedTotal")</div>
                                    <div class="summary-amount bonusUseTotalValue"></div>
                                </div>

                                <div class="summary-total-row">
                                    <div class="summary-label">@L.get("CartColSubtotal")</div>
                                    <div data-key="payableSubtotal" class="summary-amount payable_subtotal price fs-5 fw-bold red_text"></div>
                                </div>

                                <div class="summary-reward-row bonusRedeemHintLine d-none">
                                    <div class="summary-reward-box">
                                        <i class="fa-solid fa-gift summary-reward-icon"></i>
                                        <span class="bonusEarnHintText"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="js-bonus-nextstep-hint text-danger small mb-2 d-none text-center">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        <span class="js-bonus-nextstep-text"></span>
                    </div>

                    <div class="swiper_button my-5 d-flex justify-content-center">
                        <a href="@ViewData["prodCatalog"]" title="@L.get("CartContinueShoppingTitle")" class="btn_backshop btn_gray_dark border-0 mx-2 p-0 py-2 rounded-3 text-center text-white">@L.get("CartBackToShop")</a>
                        <button class="btn_swiper_next_buystep border-0 p-0 py-2 rounded-3 text-center text-white mx-2">
                            @L.get("CartNextStep")
                        </button>
                    </div>
                </div>

                <div id="Purchase_Null" class="align-items-center flex-column justify-content-center">
                    <div class="mt-5">@L.get("CartEmptyMessage")</div>
                    <a class="btn_backshop btn_gray_dark border-0 p-0 py-2 rounded-3 text-center text-white my-5" href="@ViewData["prodCatalog"]" title="@L.get("CartContinueShoppingTitle")">@L.get("CartBackToShopNow")</a>
                </div>
            </div>

            <div id="Step3" class="card text-center swiper-slide">
                <div class="card-body px-0">
                    <div id="RecipientForm" class="recipient-delivery-panel checkout-section-card">
                        <div class="recipient-panel-heading checkout-section-heading d-flex align-items-center">
                            <div>
                                <div class="fs-5">@L.get("CkRecipientSection")</div>
                                <div class="small text-muted">@L.get("CkRecipientSectionHint")</div>
                            </div>
                        </div>

                        <div class="recipient-substep px-3 px-sm-5">@L.get("CkChooseRecipient")</div>
                        <div class="recipient-source-options px-3 px-sm-5" role="radiogroup" aria-label="@L.get("CkRecipientSourceAria")">
                            <label class="recipient-source-option is-selected" for="radio_recipient_order">
                                <input id="radio_recipient_order" class="form-check-input" type="radio" name="RecipientRadio" value="order" checked>
                                <span>
                                    <strong>@L.get("CkSameAsOrderer")</strong>
                                    <small>@L.get("CkSameAsOrdererHint")</small>
                                </span>
                            </label>

                            @if (ViewBag.LoginEnable && ViewBag.isLogin)
                            {
                                <input id="radio_recipient_choose" class="d-none" type="radio" name="RecipientRadio" value="choose">
                                <button id="btn_recipient_choose"
                                        type="button"
                                        class="recipient-source-option text-start"
                                        data-bs-toggle="modal"
                                        data-bs-target="#RecipientModal">
                                    <span class="recipient-source-indicator" aria-hidden="true"></span>
                                    <span>
                                        <strong>@L.get("CkSavedRecipient")</strong>
                                        <small>@L.get("CkSavedRecipientHint")</small>
                                    </span>
                                </button>
                            }

                            <label class="recipient-source-option" for="radio_recipient_edit">
                                <input id="radio_recipient_edit" class="form-check-input" type="radio" name="RecipientRadio" value="edit">
                                <span>
                                    <strong>@L.get("CkNewRecipientA")<br class="recipient-adjust-break">@L.get("CkNewRecipientB")</strong>
                                    <small>@L.get("CkNewRecipientHint")</small>
                                </span>
                            </label>

                            <div id="RecipientActivePanel" class="recipient-active-panel" aria-live="polite">
                                <section class="checkout-orderer-section">
                                    <div class="checkout-subsection-heading px-3 py-3 d-flex align-items-center">
                                        <div>
                                            <div class="fs-5">@L.get("CkOrdererSection")</div>
                                            <div class="small text-muted">@L.get("CkOrdererSectionHint")</div>
                                        </div>
                                        <button class="btn_edit_data checkout-heading-action bg-transparent border-0 fs-4 ms-2" title="@L.get("CkEditOrderer")">
                                            <i class="fa-regular fa-pen-to-square"></i>
                                            <span class="d-none">@L.get("CkEdit")</span>
                                        </button>
                                        <button class="btn_inituser checkout-restore-button border-0 ms-auto">@L.get("CkRestoreDefault")</button>
                                    </div>

                                    <div id="OrdererForm" class="checkout-section-body">
                                        <div class="default_data checkout-data-panel">
                                            <div class="checkout-data-row">
                                                <div class="checkout-data-label">@L.get("CkName")</div>
                                                <div data-key="orderer" class="checkout-data-value"></div>
                                            </div>
                                            <div class="checkout-data-row">
                                                <div class="checkout-data-label">@L.get("CkEmail")</div>
                                                <div data-key="ordererEmail" class="checkout-data-value"></div>
                                            </div>
                                            <div class="checkout-data-row">
                                                <div class="checkout-data-label">@L.get("CkMobile")</div>
                                                <div data-key="ordererCellPhone" class="checkout-data-value"></div>
                                            </div>
                                            <div class="checkout-data-row">
                                                <div class="checkout-data-label">@L.get("CkAddress")</div>
                                                <div data-key="ordererAddress" class="checkout-data-value"></div>
                                            </div>
                                        </div>

                                        <form id="Form_Orderer" class="px-3 px-sm-5 d-none needs-validation" method="post" novalidate>
                                        <input type="hidden" name="authentiity_token" value="@Model.token" />
                                        <div class="row mx-0">
                                            <div class="form-floating mb-3 col-12 col-sm-6 px-0">
                                                <input id="OrdererInputName" class="orderer_name form-control" name="orderer" type="text" placeholder="name" value="" minlength="2" required>
                                                <label class="required" for="OrdererInputName">@L.get("CkNameLabel")</label>
                                            </div>
                                            <div class="gender d-flex align-self-center col-12 col-sm-6 mb-3">
                                                <div class="form-check pe-3">
                                                    <input id="OrdererRadioSir" class="form-check-input" type="radio" name="ordererSex" value="1">
                                                    <label class="form-check-label" for="OrdererRadioSir">@L.get("CkGenderMale")</label>
                                                </div>
                                                <div class="form-check pe-3">
                                                    <input id="OrdererRadioMiss" class="form-check-input" type="radio" name="ordererSex" value="2">
                                                    <label class="form-check-label" for="OrdererRadioMiss">@L.get("CkGenderFemale")</label>
                                                </div>
                                                <div class="form-check">
                                                    <input id="OrdererRadioElse" class="form-check-input" type="radio" name="ordererSex" value="3">
                                                    <label class="form-check-label" for="OrdererRadioElse">@L.get("CkGenderOther")</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-floating mb-3 col-12 col-sm-6 e-mail">
                                            <input id="OrdererInputMail" class="orderer_mail form-control" name="ordererEmail" type="email" placeholder="name@example.com" value="" required>
                                            <label class="required" for="OrdererInputMail">E-mail</label>
                                        </div>
                                        <div class="form-floating mb-3 col-12 col-sm-6 cell-phone">
