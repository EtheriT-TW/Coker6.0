@{
    ViewData["Title"] = "Dashboard";
}
<script src="~/lib/chart.js/chart.min.js"></script>
<script src="~/js/Dashboard/Index.min.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/Dashboard/index.min.css" asp-append-version="true" />

<div class="container-fluid py-4 dashboard">
    <div class="row g-4 dashboard-kpis">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card dashboard-kpi h-100">
                <div class="card-header p-3 pt-2">
                    <div class="icon icon-lg icon-shape bg-gradient-warning shadow-dark text-center border-radius-xl mt-n4 position-absolute">
                        <i class="material-symbols-outlined opacity-10">storage</i>
                    </div>
                    <div class="text-end pt-1">
                        <p class="text-sm mb-0">使用空間</p>
                        <h4 class="mb-0 storage-size">--</h4>
                    </div>
                </div>
                <hr class="dark horizontal my-0" />
                <div class="card-footer p-3">
                    <p class="mb-0 text-sm">最後更新：<span class="text-success font-weight-bolder storage-updated-at">載入中</span></p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card dashboard-kpi h-100">
                <div class="card-header p-3 pt-2">
                    <div class="icon icon-lg icon-shape bg-gradient-info shadow-primary text-center border-radius-xl mt-n4 position-absolute">
                        <i class="material-symbols-outlined opacity-10">monitoring</i>
                    </div>
                    <div class="text-end pt-1">
                        <p class="text-sm mb-0">本月流量</p>
                        <h4 class="mb-0 month-flow-size">--</h4>
                    </div>
                </div>
                <hr class="dark horizontal my-0" />
                <div class="card-footer p-3">
                    <p class="mb-0 text-sm">統計區間：<span class="text-success font-weight-bolder month-flow-range">載入中</span></p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card dashboard-kpi h-100">
                <div class="card-header p-3 pt-2">
                    <div class="icon icon-lg icon-shape bg-gradient-success shadow-success text-center border-radius-xl mt-n4 position-absolute">
                        <i class="material-symbols-outlined opacity-10">groups</i>
                    </div>
                    <div class="text-end pt-1">
                        <p class="text-sm mb-0">在線訪客</p>
                        <h4 class="mb-0 online-visitor-count">--</h4>
                    </div>
                </div>
                <hr class="dark horizontal my-0" />
                <div class="card-footer p-3">
                    <p class="mb-0 text-sm">最近 2 分鐘仍有瀏覽心跳，每 30 秒更新</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <a class="text-decoration-none text-reset" href="/ContentManagement/ContactUs">
                <div class="card dashboard-kpi h-100">
                    <div class="card-header p-3 pt-2">
                        <div class="icon icon-lg icon-shape bg-gradient-danger shadow-danger text-center border-radius-xl mt-n4 position-absolute">
                            <i class="material-symbols-outlined opacity-10">mark_email_unread</i>
                        </div>
                        <div class="text-end pt-1">
                            <p class="text-sm mb-0">待處理表單</p>
                            <h4 class="mb-0 pending-contact-count">--</h4>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0" />
                    <div class="card-footer p-3">
                        <p class="mb-0 text-sm">尚未開始處理的表單資料</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12 col-xl-8">
            <div class="card dashboard-panel h-100">
                <div class="card-header d-flex align-items-center justify-content-between pb-0">
                    <div>
                        <h6 class="mb-1">最近 7 天瀏覽趨勢</h6>
                        <p class="text-sm text-secondary mb-0">有效瀏覽人次與不重複訪客</p>
                    </div>
                    <span class="text-xs text-secondary traffic-updated-at"></span>
                </div>
                <div class="card-body pt-3">
                    <div class="dashboard-chart">
                        <canvas id="dashboard-traffic-chart"></canvas>
                    </div>
                    <div class="dashboard-loading traffic-loading">正在載入流量資料…</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card dashboard-panel h-100">
                <div class="card-header d-flex align-items-center justify-content-between pb-0">
                    <div>
                        <h6 class="mb-1">本日熱門頁面</h6>
                        <p class="text-sm text-secondary mb-0">依有效瀏覽次數排序，最多顯示 5 筆</p>
                    </div>
                    <span class="material-symbols-outlined text-info">local_fire_department</span>
                </div>
                <div class="card-body pt-3">
                    <div class="popular-page-list"></div>
                    <div class="dashboard-loading popular-pages-loading">正在載入熱門頁面…</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12 col-xl-7">
            <div class="card dashboard-panel h-100">
                <div class="card-header d-flex align-items-center justify-content-between pb-0">
                    <div>
                        <h6 class="mb-1">表單處理狀態</h6>
                        <p class="text-sm text-secondary mb-0">依實際表單位置分組</p>
                    </div>
                    <a class="btn btn-sm btn-outline-primary mb-0" href="/ContentManagement/ContactUs">查看全部</a>
                </div>
                <div class="card-body pt-3">
                    <div class="contact-form-summary"></div>
                    <div class="dashboard-loading contact-summary-loading">正在載入表單統計…</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card dashboard-panel h-100">
                <div class="card-header d-flex align-items-center justify-content-between pb-0">
                    <div>
                        <h6 class="mb-1">最近提交資料</h6>
                        <p class="text-sm text-secondary mb-0">顯示最近 5 筆表單資料</p>
                    </div>
                    <span class="material-symbols-outlined text-success">schedule</span>
                </div>
                <div class="card-body pt-3">
                    <div class="recent-contact-list"></div>
                    <div class="dashboard-loading recent-contacts-loading">正在載入最近提交…</div>
                </div>
            </div>
        </div>
    </div>
</div>
