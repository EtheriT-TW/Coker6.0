@{
    ViewData["Title"] = "網站與站台";
}
<div data-platform-page="websites">
    <section class="page-heading"><div><h1>網站與站台</h1><p>查看各客戶擁有的網站、環境與目前運作狀態。</p></div></section>
    <section class="placeholder-card"><div><span class="placeholder-icon"><span class="material-symbols-outlined">language</span></span><h2>站台管理功能預留</h2><p>此階段先建立頁面入口與版面。後續可從既有 Websites 資料延伸站台概況與跨區資料來源。</p><span class="phase-badge">尚未接入資料</span></div></section>
</div>

@section Scripts {
    <environment include="Development">
        <script type="module" src="~/js/modules/pages/websites.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="module" src="~/dist/js/pages/websites.js" asp-append-version="true"></script>
    </environment>
}
