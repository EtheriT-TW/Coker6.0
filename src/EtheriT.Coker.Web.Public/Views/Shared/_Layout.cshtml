        @await RenderSectionAsync("Scripts", required: false)
        <style id="frameCss" nonce="@ViewBag.Nonce">
                @Html.Raw(HttpUtility.HtmlDecode(ViewBag.Css))
        </style>
        <script nonce="@ViewBag.Nonce">
                (() => {
                    const root = document.documentElement;
                    const reveal = () => {
                        requestAnimationFrame(() => requestAnimationFrame(() => {
                            root.classList.add("coker-prepaint-ready");
                            window.setTimeout(() => {
                                root.classList.remove("coker-prepaint", "coker-prepaint-ready");
                                root.removeAttribute("aria-busy");
                            }, 140);
                        }));
                    };

                    const stylesheetReady = Array.from(document.querySelectorAll('link[rel="stylesheet"]'))
                        .map(link => link.sheet
                            ? Promise.resolve()
                            : new Promise(resolve => {
                                link.addEventListener("load", resolve, { once: true });
                                link.addEventListener("error", resolve, { once: true });
                            }));

                    const fontsReady = document.fonts?.ready ?? Promise.resolve();
                    const resourcesReady = Promise.all([...stylesheetReady, fontsReady]);
                    const timeout = new Promise(resolve => window.setTimeout(resolve, 2000));

                    Promise.race([resourcesReady, timeout]).then(reveal, reveal);
                })();
        </script>
    </body>
</html>
