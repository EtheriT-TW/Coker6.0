                                    StringComparison.OrdinalIgnoreCase);

                                <div class="form-check text-start m-0 p-0 @(isEmbedded ? "d-none" : "")">
                                    <input id="radio_payment_@payment.Code"
                                           class="form-check-input d-none"
                                           type="radio"
                                           name="RadioPayment"
                                           data-maxamount="@payment.MaxAmount"
                                           data-minamount="@payment.MinAmount"
                                           data-availability-id="@payment.Id"
                                           value="@payment.Id"
                                           data-third-party-id="@payment.FK_ThirdPartyId"
                                           data-provider-code="@payment.ProviderCode"
                                           data-render-mode="@payment.RenderMode"
                                           data-code="@payment.Code"
                                           data-cvs-store-selection-mode="@((int)payment.CvsStoreSelectionMode)"
                                           required
                                           data-title="@payment.Title">

                                    <div id="payment_@payment.Code"
                                         class="payment_display d-flex justify-content-between"
                                         data-radioid="radio_payment_@payment.Code">
                                        <div class="d-flex align-items-center">
                                            <span class="paymentradio d-block"></span>
                                            <div class="payment-copy">
                                                <div class="paymenttitle">@payment.Title</div>
                                                <div class="payment-unavailable-reason small d-none"
                                                     role="note"></div>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(payment.Icon))
                                        {
                                            <img class="paymenticon px-1"
                                                 src="@payment.Icon"
                                                 alt="@payment.Title">
                                        }
                                    </div>
                                </div>
                            }

                            @if (Model.paymentModels.Any(e => string.Equals(
                                e.RenderMode,
                                "Embedded",
                                StringComparison.OrdinalIgnoreCase)))
                            {
                                <div class="payment_provider_loading text-start col-12 col-sm-3 my-2 py-2 d-none">
                                    @L.get("CkPaymentLoading")
                                </div>

                                <div id="EmbeddedPayment">
                                    <div id="ECPayPayment"
                                         data-server-type="@(ViewBag.IsProduction ? "Prod" : "Stage")"></div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="nopayment">@L.get("CkNoPaymentSet")</div>
                        }
                    </form>
                    <div id="CvsStoreSelection" class="checkout-cvs-store-section d-none px-3 px-sm-4 pb-4">
                        <div class="checkout-cvs-store-heading">@L.get("CkPickupStore")</div>
                        <div class="cvs-store-picker">
                            <input type="button"
                                   class="btn_getmap cvs-store-button d-none"
                                   value="@L.get("CkChoosePickupStore")"
                                   aria-describedby="CvsStoreStatus"
                                   title="@L.get("CkSelectPickupStore")">
                            <div id="CvsStoreStatus"
                                 class="cvs-store-status"
                                 role="status"
                                 aria-live="polite"></div>
                        </div>
                    </div>
                    </section>

                    <div class="swiper_button mt-4 my-sm-5 row align-items-center justify-content-center">
                        <button class="btn_gray_underline btn_goprev col-auto order-1 order-sm-0 border-0 text-center text-decoration-underline bg-transparent p-2">
                            @L.get("CkBack")
                        </button>

                        <div class="col-12 col-sm-auto order-0 order-sm-1">
                            <button class="btn_checkout border-0 px-4 py-2 mx-3 rounded-3 text-center text-white">
                                <div class="fs-2 fw-bold">@L.get("CkConfirmCheckout")</div>
                                <div>@L.get("CkGoToPayment")</div>
                            </button>
                        </div>

                        <a class="btn_backshop btn_gray_underline btn_gray_dark col-auto order-2 border-0 text-center text-decoration-underline bg-transparent p-2" href="@ViewData["prodCatalog"]" title="@L.get("CartContinueShoppingTitle")">@L.get("CkShopMore")</a>
                    </div>
                </div>
            </div>

            <div id="Step4" class="card swiper-slide">
                <div class="card-header px-3 py-2 d-flex align-items-center justify-content-between">
                    <div class="fs-5 my-2">@L.get("CartDetailTitle")</div>
                    <div class="order_number fs-5 fw-bold"></div>
                </div>

                <div class="card-body px-0">
                    <div class="pruchase_content">
                        <div class="status_alert fs-3 fw-bold mt-4 text-center"></div>
                        <div class="thirdpay_link d-flex justify-content-center d-none">@L.get("CkRedirectPrefix") [<span><a href="" title="@L.get("CkThirdPayLinkTitle")" target="_blank" rel="noopener noreferrer" class="text-decoration-underline fw-bold">@L.get("CkGoManually")</a></span>] @L.get("CkLinkValidity")</div>
                        <div class="order_time pe-5 text-end">@L.get("CkOrderTimeLabel")</div>
                        @if (!ViewBag.isLogin)
                        {
                            <div class="buyagain_text fs-5 text-center d-none">@L.get("CkBuyAgainPrefix")<span class="px-1 text-decoration-underline">@L.get("CkBuyAgainLink")</span>@L.get("CkBuyAgainSuffix")</div>
                        }

                        <ul id="Purchase" class="purchase_list px-5 mb-0"></ul>

                        <ul id="CollapsePurchase" class="purchase_list pb-4 px-5 collapse"></ul>

                        <template id="Template_Purchase_Details">
                            <li class="purchase_item row border-bottom py-2 align-items-lg-center position-relative">
                                <div class="image col-lg-6 col-sm-2 col-4 row gx-0">
                                    <a data-key="link" class="pro_link col-lg-2 col-12" href="" title="@L.get("LinkTo", L.get("CartProductAlt"))" target="_blank" rel="noopener noreferrer">
                                        <img data-key="imagePath" class="pro_image img-fluid" alt="@L.get("CartProductAlt")" src="">
                                    </a>
                                    <a data-key="link" class="pro_link col text-start overflow-hidden" href="" title="@L.get("LinkTo", L.get("CartProductAlt"))" target="_blank" rel="noopener noreferrer">
                                        <div class="content d-lg-block d-none">
                                            <div data-key="title" class="pro_name single_line fw-bold"></div>
                                            <div class="pro_detail d-flex flex-wrap">
                                                <div data-key="spec" class="pro_specification pe-3"></div>
                                                @* <div data-key="describe" class="pro_instructions single_line"></div> *@
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <div class="content col-sm-6 col row gx-0 overflow-hidden">
                                    <a data-key="link" class="pro_link" href="" title="@L.get("LinkTo", L.get("CartProductAlt"))" target="_blank" rel="noopener noreferrer">
                                        <div class="d-lg-none d-block text-start">
                                            <div data-key="title" class="pro_name single_line fw-bold"></div>
                                            <div class="pro_detail d-flex flex-wrap">
                                                <div data-key="spec" class="pro_specification pe-3"></div>
                                                <div data-key="describe" class="pro_instructions single_line"></div>
                                            </div>
                                        </div>
                                    </a>

                                    <div class="step4-item-price col-12 col-lg-4 my-3 my-lg-0 fs-5 align-self-center text-start text-lg-center">
                                        <div data-key="price" class="pro_unit"></div>
                                        <div data-key="bonus" class="pro_bonus"></div>
                                    </div>

                                    <div data-key="quantity" class="pro_quantity col-12 col-lg-4 fs-5 d-flex justify-content-start justify-content-lg-center"></div>

                                    <div class="pro_subtotal col-4 fw-bold fs-5 d-none text-center">
                                        <div data-key="subtotal" data-subtotal=""></div>
                                        <div data-key="subtotalBonus"></div>
                                    </div>
                                </div>
                            </li>
                        </template>

                        <div class="d-flex justify-content-center mt-3">
                            <button class="btn_view_list border-0 rounded-pill fs-5 px-5 py-2 d-none" type="button" data-bs-toggle="collapse" data-bs-target="#CollapsePurchase" aria-expanded="false" aria-controls="CollapsePurchase">
                                @L.get("CkViewCartList")
                            </button>
                        </div>

                        <div class="mt-3 endline px-3 pe-sm-5 col-12 col-md-6 offset-md-6">
                            <div class="py-2 d-flex justify-content-end text-end step4GeneralProductAmountLine d-none">
                                <div>@L.get("CartGeneralAmount")</div>
                                <div class="step4GeneralProductAmount col-4 price">0</div>
                            </div>

                            <div class="py-2 d-flex justify-content-end text-end step4AddOnProductAmountLine d-none">
                                <div>@L.get("CartAddOnAmount")</div>
                                <div class="step4AddOnProductAmount col-4 price">0</div>
                            </div>

                            <div class="py-2 d-flex justify-content-end text-end step4ProductAmountLine">
                                <div>@L.get("CartProductAmount")</div>
                                <div data-key="productSubtotal" class="subtotal col-4 price">0</div>
                            </div>

                            <div class="step4MarketingDiscountLines d-none"></div>

                            <div class="py-2 d-flex justify-content-end text-end productBonusLine d-none">
                                <div>@L.get("CkProductBonus")</div>
                                <div data-key="productBonus" class="productBonusValue col-4">@L.get("CkPoints", 0)</div>
                            </div>

                            <div class="py-2 d-flex justify-content-end text-end bonusDiscionLine d-none">
                                <div class="summary-label">@L.get("CartBonusDiscount")</div>
                                <div data-key="redeemBonus" class="bonusDiscion col-4 price-negative">@L.get("CkPoints", 0)</div>
                            </div>

                            <div class="py-2 d-flex justify-content-end text-end">
                                <div>@L.get("CkShippingFee")</div>
                                <div data-key="freight" class="shipping_fee col-4 price">0</div>
                            </div>

                            <div class="py-2 d-flex justify-content-end text-end bonusUseTotalLine d-none">
                                <div>@L.get("CkTotalBonus")</div>
                                <div data-key="bonus" class="bonusUseTotalValue col-4">@L.get("CkPoints", 0)</div>
                            </div>

                            <div class="py-2 border-top d-flex justify-content-end text-end align-items-baseline">
                                <div>@L.get("CkTotalAmount")</div>
                                <div data-key="total" class="total_amount col-4 price fs-5 fw-bold">0</div>
                            </div>
                        </div>

                    </div>

                    <div class="orderer_data">
                        <div class="title px-3 py-2 my-3 d-flex align-items-center fs-5 text-end">@L.get("CkOrdererSection")</div>

                        <div class="content">
                            <div class="row">
                                <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkNameColon")</div>
                                <div data-key="orderer" data-type="name" class="col text-start ps-0"></div>
                            </div>
                            <div class="row">
                                <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkEmailColon")</div>
                                <div data-key="ordererEmail" data-type="email" class="col text-start ps-0"></div>
                            </div>
                            <div class="row">
                                <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkMobileColon")</div>
                                <div data-key="ordererCellPhone" data-type="phone" class="col text-start ps-0"></div>
                            </div>
                        </div>
                    </div>

                    <div class="recipient_data">
                        <div class="title px-3 py-2 my-3 d-flex align-items-center fs-5">@L.get("CkRecipientDetails")</div>

                        <div class="content">
                            <div class="row">
                                <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkNameColon")</div>
                                <div data-key="recipient" data-type="name" class="col text-start ps-0"></div>
                            </div>
                            <div class="row">
                                <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkEmailColon")</div>
                                <div data-key="recipientEmail" data-type="email" class="col text-start ps-0"></div>
                            </div>
                            <div class="row">
                                <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkMobileColon")</div>
                                <div data-key="recipientCellPhone" data-type="phone" class="col text-start ps-0"></div>
                            </div>
                            <div class="row">
                                <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkAddressColon")</div>
                                <div data-key="recipientAddress" data-type="address" class="col text-start ps-0"></div>
                            </div>
                        </div>
                    </div>
                    @if (invoiceMode == "EnabledInvoice")
                    {
                        <div class="invoice_type" data-invoice-mode="EnabledInvoice" data-carrier-count="@ViewBag.Carrier.Count">
                            <div class="title px-3 py-2 my-3 d-flex align-items-center fs-5">@L.get("CkInvoiceTypeColon")<span class="fs-6" data-key="InvoiceTypeTitle"></span></div>
                            <div class="content">
                                <div class="person d-none">
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkTypeColon")</div>
                                        <div data-key="personalInvoiceTypeTitle" class="col text-start ps-0"></div>
                                    </div>
                                    @if (ViewBag.Carrier.Contains("MobileCarrier"))
                                    {
                                        <div class="mobileCarrier d-none">
                                            <div class="row">
                                                <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkMobileBarcodeColon")</div>
                                                <div data-key="carrier" class="col text-start ps-0"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="company d-none">
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkInvoiceTitleColon")</div>
                                        <div data-key="invoiceTitle" class="col text-start ps-0"></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkTaxIdColon")</div>
                                        <div data-key="uniformId" class="col text-start ps-0"></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkAddressColon")</div>
                                        <div data-key="invoiceAddress" class="col text-start ps-0"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="invoice_data">
                            <div class="title px-3 py-2 my-3 d-flex align-items-center fs-5">@L.get("CkInvoiceDelivery")</div>

                            <div class="content">
                                <div class="orderer d-none">
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkNameColon")</div>
                                        <div data-key="orderer" data-type="name" class="col text-start ps-0"></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkEmailColon")</div>
                                        <div data-key="ordererEmail" data-type="email" class="col text-start ps-0"></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkMobileColon")</div>
                                        <div data-key="ordererCellPhone" data-type="phone" class="col text-start ps-0"></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkAddressColon")</div>
                                        <div data-key="ordererAddress" data-type="address" class="col text-start ps-0"></div>
                                    </div>
                                </div>
                                <div class="recipient d-none">
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkNameColon")</div>
                                        <div data-key="recipient" data-type="name" class="col text-start ps-0"></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkEmailColon")</div>
                                        <div data-key="recipientEmail" data-type="email" class="col text-start ps-0"></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkMobileColon")</div>
                                        <div data-key="recipientCellPhone" data-type="phone" class="col text-start ps-0"></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkAddressColon")</div>
                                        <div data-key="recipientAddress" data-type="address" class="col text-start ps-0"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (invoiceMode == "UniformIdOnly")
                    {
                        <div class="invoice_type" data-invoice-mode="UniformIdOnly">
                            <div class="title px-3 py-2 my-3 d-flex align-items-center fs-5">@L.get("CkInvoiceTypeColon")<span class="fs-6" data-key="InvoiceTypeTitle"></span></div>
                            <div class="content">
                                <div class="row uniformPersonalTypeValue d-none">
                                    <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkTypeColon")</div>
                                    <div data-key="personalInvoiceTypeTitle" class="col text-start ps-0"></div>
                                </div>
                                @if (ViewBag.Carrier.Contains("MobileCarrier"))
                                {
                                    <div class="row mobileCarrier d-none">
                                        <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkMobileBarcodeColon")</div>
                                        <div data-key="carrier" class="col text-start ps-0"></div>
                                    </div>
                                }
                                <div class="row uniformIdOnlyValue d-none">
                                    <div class="col-auto col-sm-2 text-end ps-4">@L.get("CkTaxIdFullColon")</div>
                                    <div data-key="uniformId" class="col text-start ps-0"></div>
                                </div>
                            </div>
                        </div>
                    }
                    <div id="PaymentData">
                        <div class="storememo d-none">@ViewData["storeMemo"]</div>
                        <div class="title px-3 py-2 my-3 d-flex align-items-center">
                            <div class="fs-5">@L.get("CkPayment")</div>
                            <div data-key="payment" class="payment_method px-3 fs-5">@L.get("CkNoPaymentChosen")</div>
                        </div>

                        <div class="pay_info px-4 d-none">
                            <p>@L.get("CkTransferNotice")</p>
                            <div class="transfer_payment_info border rounded text-start p-3 my-3 d-none">
                                <div class="fw-bold fs-5 mb-2">@L.get("CkTransferInfo")</div>
                                <div class="transfer_payment_fields"></div>
                            </div>
                            <div class="border-bottom border-top text-start py-3 my-3">
                                <div class="mb-2 row align-items-center">
                                    <div class="col-auto col-sm-2 text-end">@L.get("CkAmountDue")</div>
                                    <div class="col ps-0"><span class="total_amount paid_amount fs-5 fw-bold"></span></div>
                                </div>
                                <div class="paid_date_row mb-2 row align-items-center d-none">
                                    <div class="col-auto col-sm-2 text-end">@L.get("CkPayDeadline")</div>
                                    <div class="paid_date col ps-0"></div>
                                </div>
                            </div>
                        </div>
                        <p class="pay_mail px-4"></p>
                        <div class="btn_back_home d-flex justify-content-center my-4">
                            <a href="/@ViewData["OrgName"]/home">
                                <div class="fs-5 fw-bold px-3 py-1 rounded text-white">@L.get("returnHomePage")</div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


@section Scripts {
    <script src="~/js/Payment/Payment.min.js" asp-append-version="true"></script>
    <script src="~/js/Page/ShoppingCart.min.js" asp-append-version="true"></script>
}
