@using EtheriT.Coker.Web.Public.Views.Shared.Components.LayoutType
@using EtheriT.Coker.Web.Public.Views.Shared.Components.SideFloating
@using EtheriT.Coker.Web.Public.Views.Shared.Components.Modal
@using EtheriT.Coker.Application.Shared.i18n;
@using System.Web;
@{
    var nonce = ViewContext.HttpContext.Items["CSPNonce"] as string;
    ViewBag.Nonce = nonce;
    var bodyClass = string.Join(" ",
        ViewData["bodyClass"]?.ToString(),
        ViewBag.NoCopy?.ToString(),
        ViewBag.option?.ToString()
    ).Trim();
    // DevExtreme 檔案較大，預設不載入；需要的頁面設定 ViewData["UseDevExtreme"] = true。
    var useDevExtreme = ViewData["UseDevExtreme"] as bool? == true;
}
<!DOCTYPE html>
<html lang="@ViewData["Locale"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Html.Raw(ViewBag.PageTagNameName)</title>
    <script nonce="@ViewBag.Nonce">
            document.documentElement.classList.add("coker-prepaint");
            document.documentElement.setAttribute("aria-busy", "true");
    </script>
    <style nonce="@ViewBag.Nonce">
            html.coker-prepaint::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: 2147483646;
                background: #fff;
                opacity: 1;
                transition: opacity 120ms ease-out;
            }

            html.coker-prepaint::after {
                content: "";
                position: fixed;
                top: 50%;
                left: 50%;
                z-index: 2147483647;
                width: 2.5rem;
                height: 2.5rem;
                margin: -1.25rem 0 0 -1.25rem;
                border: .25rem solid #e5e5e5;
                border-top-color: #777;
                border-radius: 50%;
                opacity: 1;
                animation: coker-prepaint-spin .75s linear infinite;
                transition: opacity 120ms ease-out;
            }

            html.coker-prepaint.coker-prepaint-ready::before,
            html.coker-prepaint.coker-prepaint-ready::after {
                opacity: 0;
            }

            @@keyframes coker-prepaint-spin {
                to {
                    transform: rotate(360deg);
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                html.coker-prepaint::after {
                    animation: none;
                }
            }
    </style>
    <style nonce="@ViewBag.Nonce">
            @@media (max-width: 767.98px) {
                .coker-desktop-breadcrumb {
                    display: none !important;
                }
            }
    </style>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fortawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/aos/aos.css" />
    <link rel="stylesheet" href="~/Shared/shared.min.css" asp-append-version="true" />
    @if (useDevExtreme)
    {
        <link rel="stylesheet" href="~/css/vendor.min.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/Header/Header.min.css" asp-append-version="true" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" asp-append-version="true" />
    <link rel="canonical" href="@ViewData["CanonicalUrl"]" />
    @await Component.InvokeAsync(nameof(LayoutType))

    <meta name="author" content="易碩網際科技股份有限公司" />
    <meta name="copyright" content="易碩網際科技股份有限公司" />
    <meta name="description" content="@ViewData["Description"]">
    <meta itemprop="name" content="@Html.Raw(ViewBag.PageTagNameName)" />
    <meta itemprop="description" content="@ViewData["Description"]" />
    <meta name="twitter:title" content="@Html.Raw(ViewBag.PageTagNameName)" />
    <meta name="twitter:description" content="@ViewData["Description"]" />
    @if (!string.IsNullOrEmpty(ViewBag.ImageUrl))
    {
        <meta name="twitter:image" content="@Html.Raw(ViewBag.ImageUrl)">
    }
    <meta property="og:title" content="@Html.Raw(ViewBag.PageTagNameName)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@(ViewData["OpenGraphUrl"] ?? ViewData["CurrentUrl"])" />
    <meta property="og:site_name" content="@Html.Raw(ViewData["SideName"])" />
    <meta property="og:description" content="@ViewData["Description"]" />
    @if (!string.IsNullOrEmpty(ViewBag.ImageUrl))
