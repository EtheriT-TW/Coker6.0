@using EtheriT.Coker.Application.Shared.Dto.enumType
@using EtheriT.Coker.Web.MVC.Views.Shared.Components.Modal;
@model EtheriT.Coker.Application.Dto.StoreSet.StoreSetResponseMessageDto;
<link rel="stylesheet" href="~/css/SystemManagement/SEO.min.css" asp-append-version="true" />
<script src="~/js/SystemManagement/SEOSetting.min.js" asp-append-version="true"></script>

<div id="TopLine" class="d-flex justify-content-between mb-3 px-4">
    <div class="title fw-bold fs-3">@ViewData["PageHeading"]</div>
    <a class="btn btn-primary text-decoration-none align-self-center d-none" href="#" role="button">返回網站資料</a>
</div>
<div id="WebDataMain">
    <!-- Store settings -->
    <div class="py-2">
        <form id="StoreSet" class="needs-validation" data-groupId="@Model.StoreSetGroupId" novalidate>
            @{
                if (Model.Success && Model.storeGroups != null)
                {
                    for (int i = 0; i < Model.storeGroups.Count; i++)
                    {
                        var group = Model.storeGroups[i];

                        <section id="Setting@(group.Title)" class="card border-0 shadow-sm mb-4">
                            <div class="card-body">
                                <div class="seo-setting-group-header d-flex align-items-center pb-2">
                                    @if (!string.IsNullOrWhiteSpace(group.Image))
                                    {
                                        <img class="seo-setting-group-icon" src="@(group.Image)" alt="" width="30" />
                                    }
                                    <div class="fs-5 fw-bold px-2">@group.Title</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(group.Description))
                                {
                                    <div class="text-secondary mb-3">@group.Description</div>
                                }

                                @for (int j = 0; j < group.storeSets.Count; j++)
                                {
                                    var item = group.storeSets[j];
                                    @switch (item.type)
                                    {
                                        case SeoSetDataTypeEnum.text:
                                        case SeoSetDataTypeEnum.number:
                                        case SeoSetDataTypeEnum.email:
                                        case SeoSetDataTypeEnum.date:
                                        case SeoSetDataTypeEnum.password:
                                            <div class="seo-setting-field-row d-flex flex-wrap align-items-center gap-3 mb-3">
                                                <label class="form-label m-0" for="@(item.key)">@item.name</label>
                                                <input id="@(item.key)" name="@(item.key)" autocomplete="off" class="form-control text-center rounded w-auto" type="@(item.type)" @(string.IsNullOrEmpty(item.pattern) ? "" : $"pattern={item.pattern}") maxlength="@(item.maxlength)">
                                                <label class="form-text m-0" for="@(item.key)">@item.memo</label>
                                            </div>
                                            break;
                                        case SeoSetDataTypeEnum.textarea:
                                            <div class="mb-3">
                                                <label class="form-label m-0" for="@(item.key)">@item.name</label>
                                                <textarea id="@(item.key)" name="@(item.key)" autocomplete="off" class="form-control p-2" placeholder="@item.memo" maxlength="@(item.maxlength)" rows="6"></textarea>
                                            </div>
                                            break;
                                        case SeoSetDataTypeEnum.checkBox:
                                            <div class="d-flex flex-column">
                                                <div class="form-label m-0">@item.name</div>
                                                <div class="d-flex align-items-center border border-1 my-2 py-2 rounded">
                                                    @foreach (var checkItem in item.storeSetItems)
                                                    {
                                                        <input id="@($"{item.key}-{checkItem.Key}")" autocomplete="off" name="@(item.key)" class="mx-3" type="checkbox" value="@checkItem.Key">
                                                        <label for="@($"{item.key}-{checkItem.Key}")">@checkItem.Value</label>
                                                    }
                                                </div>
                                                <div class="form-label m-0">@item.memo</div>
                                            </div>
                                            break;
                                        case SeoSetDataTypeEnum.select:
                                            <div class="mb-3">
                                                <label class="form-label m-0 required_all" for="@(item.key)">@item.name</label>
                                                <select id="@(item.key)" name="@(item.key)" class="form-select" autocomplete="off" required>
                                                    <option value="">@item.memo</option>
                                                    @foreach (var checkItem in item.storeSetItems)
                                                    {
                                                        <option value="@checkItem.Key">@checkItem.Value</option>
                                                    }
                                                </select>
                                                <div class="invalid-feedback">
                                                    @item.name 不可為空
                                                </div>
                                            </div>
                                            break;
                                        case SeoSetDataTypeEnum.radio:
                                            <fieldset class="mb-3">
                                                <legend class="form-label m-0">@item.name</legend>
                                                <div class="d-flex flex-wrap gap-3 border border-1 my-2 p-3 rounded">
                                                    @foreach (var checkItem in item.storeSetItems)
                                                    {
                                                        var optionId = $"{item.key}-{checkItem.Key}";
                                                        <div class="form-check form-check-inline m-0">
                                                            <input id="@optionId"
                                                                   name="@(item.key)"
                                                                   class="form-check-input"
                                                                   type="radio"
                                                                   autocomplete="off"
                                                                   value="@checkItem.Key"
                                                                   checked="@(checkItem.IsDefault ? "checked" : null)">
                                                            <label class="form-check-label" for="@optionId">@checkItem.Value</label>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="form-text">@item.memo</div>
                                            </fieldset>
                                            break;
                                    }
                                }
                            </div>
                        </section>
                    }
                    <div class="d-flex justify-content-center m-4">
                        <button class="btn submit rounded-2 bg-danger text-white" form="StoreSet">儲存</button>
                    </div>
                }
            }
        </form>
    </div>
</div>
