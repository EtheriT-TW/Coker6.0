<!--導入grapesjs-->
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@inject EtheriT.Coker.Application.LoginUserData LoginUserData
@using EtheriT.Coker.Web.MVC.Extensions
@using EtheriT.Coker.Web.MVC.Common
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject EtheriT.Coker.Web.MVC.Services.Ai.CanvasAiAvailability AiAvailability
@{
    var grapesModuleUrl = FileVersionProvider.AddFileVersionToPath(
        Context.Request.PathBase,
        "/modules/grapesjs/etherit-coker-grapesjs.min.js");
    var imageEditorModuleUrl = FileVersionProvider.AddFileVersionToPath(
        Context.Request.PathBase,
        "/modules/grapesjs/etherit-coker-grapesjs-image-editor.min.js");
    var siteLocale = await LoginUserData.GetWebsiteLocal();
    var canEditPage = Context.GetPermission().CanUpdate;
    var canExecuteAi = Context.HasPermission(CokerContextKeys.AiAssistant);
    var aiReadiness = canEditPage && canExecuteAi
        ? await AiAvailability.CheckAsync(Context.RequestAborted) : null;
    bool? aiServiceReady = aiReadiness?.Available;
    var canUseAi = canEditPage && canExecuteAi && aiServiceReady == true;
}

<link rel="stylesheet" href="/modules/grapesjs/etherit-coker-grapesjs.min.css" asp-append-version="true">
<link rel="stylesheet" href="/modules/grapesjs/etherit-coker-grapesjs-image-editor.min.css" asp-append-version="true">
<link rel="stylesheet" href="/css/Grapes/GrapesOutsiteCss.min.css" asp-append-version="true">
<link rel="stylesheet" href="/css/Grapes/GrapesJs-Coker6-Form.min.css" asp-append-version="true">
<script src="~/js/Grapes/grapesJs-Coker6-Form.min.js" charset="utf-8" asp-append-version="true"></script>
<script src="~/js/Grapes/grapesjs-Coker6.min.js" charset="utf-8" asp-append-version="true"></script>

<script>
    window.CokerGrapesReady = (async function () {
        const [grapesModule, imageEditorModule] = await Promise.all([
            import('@Html.Raw(grapesModuleUrl)'),
            import('@Html.Raw(imageEditorModuleUrl)')
        ]);
        const {
            createCokerGrapesLibrary,
            createCokerGrapesEditor,
            grapesjs: viteGrapesjs
        } = grapesModule;

        // Safe diagnostics: never include credentials, HTML or conversation content.
        window.CokerCanvasAiStatus = {
            canEditPage: @Json.Serialize(canEditPage),
            canExecuteAi: @Json.Serialize(canExecuteAi),
            serviceReady: @Json.Serialize(aiServiceReady),
            serviceReason: @Json.Serialize(aiReadiness?.Reason ?? "PermissionCheckFailed"),
            serviceHttpStatus: @Json.Serialize(aiReadiness?.HttpStatus),
            serviceResultCached: @Json.Serialize(aiReadiness?.Cached ?? false),
            enabled: @Json.Serialize(canUseAi),
            pluginAvailable: typeof grapesModule.aiAssistantPlugin === 'function'
        };
        if (!window.CokerCanvasAiStatus.enabled || !window.CokerCanvasAiStatus.pluginAvailable) {
            console.info('[Coker AI] 入口檢查', window.CokerCanvasAiStatus);
        }

        // Preserve the legacy global API while using the Vite-managed instance.
        window.grapesjs = viteGrapesjs;
        window.CokerGrapesTuiImageEditorPlugin = imageEditorModule.createTuiImageEditorPlugin();

        const library = createCokerGrapesLibrary({
            ui: {
                alert(message) {
                    if (window.co?.sweet?.warn) {
                        window.co.sweet.warn('提示', message);
                        return;
                    }

                    window.alert(message);
                },

                success(message) {
                    if (window.co?.sweet?.success) {
                        window.co.sweet.success(message);
                        return;
                    }

                    window.alert(message);
                },

                error(message) {
                    if (window.co?.sweet?.error) {
                        window.co.sweet.error('錯誤', message);
                        return;
                    }

                    window.alert(message);
                },

                confirm(message, options = {}) {
                    if (!window.co?.sweet?.confirm) {
                        return window.confirm(message);
                    }

                    return new Promise(resolve => {
                        window.co.sweet.confirm(
                            options.title || '確認',
                            message,
                            options.confirmText || '確定',
                            options.cancelText || '取消',
                            () => resolve(true),
                            () => resolve(false)
                        );
                    });
                }
            },
            ai: {
                async generate(request, { signal } = {}) {
                    const response = await fetch(@Json.Serialize(Url.Content("~/api/CanvasAi/Chat")), {
                        method: 'POST', credentials: 'same-origin', signal,
                        headers: {
                            'Content-Type': 'application/json',
                            'x-xsrf-token': @Json.Serialize(Antiforgery.GetAndStoreTokens(Context).RequestToken)
                        },
                        body: JSON.stringify({
                            ...request,
                            websiteId: @Json.Serialize(await LoginUserData.GetWebsiteId()),
                            controller: @Json.Serialize(Context.Request.RouteValues["controller"]?.ToString()),
                            action: @Json.Serialize(Context.Request.RouteValues["action"]?.ToString())
                        })
                    });
                    const result = await response.json();
                    if (!response.ok) {
                        const error = new Error(result.message || 'AI 請求失敗，請重新登入或稍後重試。');
                        error.serviceUnavailable = result.serviceUnavailable === true || [401, 403, 429].includes(response.status) || response.status >= 500;
                        throw error;
                    }
                    return result;
                }
            }
        });

        library.createEditor = function (options = {}) {
            let unsavedIdentity;
            const adapter = options.adapter ? {
                ...options.adapter,
                ai: { ...library.adapter.ai, ...(options.adapter.ai || {}) }
            } : library.adapter;
            return createCokerGrapesEditor({
                siteLocale: @Json.Serialize(siteLocale),
                ...options,
                adapter,
                aiAssistant: {
                    ...(options.aiAssistant || {}),
                    enabled: @Json.Serialize(canUseAi) && options.aiAssistant?.enabled !== false,
                    draftKey(editor) {
                        const container = editor.getContainer();
                        const id = window.jQuery ? window.jQuery(container).data('id') : container.dataset.id;
                        if (!id && !unsavedIdentity) {
                            let hash = 2166136261;
                            for (const c of editor.getHtml()) hash = Math.imul(hash ^ c.charCodeAt(0), 16777619);
                            unsavedIdentity = `new-${hash >>> 0}`;
                        }
                        return JSON.stringify([
                            @Json.Serialize(await LoginUserData.GetUserId()),
                            @Json.Serialize(await LoginUserData.GetWebsiteId()),
                            @Json.Serialize(Context.Request.RouteValues["controller"]?.ToString()),
                            @Json.Serialize(Context.Request.RouteValues["action"]?.ToString()),
                            location.pathname, container.id, id || unsavedIdentity
                        ]);
                    }
                }
            });
        };
        window.EtheriTCokerGrapesJS = library;

        console.log('[EtheriT.Coker.GrapesJS] module loaded', window.EtheriTCokerGrapesJS);
        return window.EtheriTCokerGrapesJS;
    })();
</script>

<script src="~/js/Grapes/Index.min.js" asp-append-version="true"></script>
<script type="text/javascript" src="/lib/bootstrap/iconpicker/js/iconset/google_Material_Symbols_Outlined.min.js" asp-append-version="true"></script>
<script type="text/javascript" src="/lib/bootstrap/iconpicker/js/bootstrap-iconpicker.min.js" asp-append-version="true"></script>
@{
    await Html.RenderPartialAsync(@"GrapesComponents\_PopupDirectory");
}
