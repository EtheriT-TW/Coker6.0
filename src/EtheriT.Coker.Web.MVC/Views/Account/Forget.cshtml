@{
    ViewData["Title"] = "忘記密碼";
}
<link rel="stylesheet" href="~/css/Account/login.min.css" asp-append-version="true" />
<script src="~/js/Account/Index.js" asp-append-version="true"></script>
<div class="row align-items-center justify-content-center align-items-center">
    <div class="col-md-12">
        <div class="form-block mx-auto">
            <div class="text-center mb-5">
                <h3 class="text-uppercase">@ViewData["Title"]</h3>
            </div>
            <form id="forgetPasswordForm">
                <p>首次使用後台且尚未設定帳號者，請透過此流程驗證信箱，設定登入帳號及獨立後台密碼。需先由管理員授予後台管理權限。</p>
                <div class="form-floating form-group first">
                    <input type="email" class="form-control" placeholder="請輸入 Email" id="email" autocomplete="email" required>
                    <label for="email">電子信箱</label>
                </div>
                <div class="d-sm-flex mb-5 align-items-center">
                    <span class="ml-auto">
                        <a class="forgot-pass" asp-area="" asp-controller="Account" asp-action="Index">回到登入頁</a>
                    </span>
                </div>
                <input id="forgetPasswordBtn" type="submit" value="寄送密碼重設信" class="btn btn-block py-2 btn-primary">
            </form>
        </div>
    </div>
</div>
