    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @if (useDevExtreme)
    {
        <script src="~/js/vendor.min.js" asp-append-version="true" nonce="@ViewBag.Nonce"></script>
        <script src="~/js/devextreme/localization/dx.messages.zh-tw.js" asp-append-version="true"></script>
        <script nonce="@ViewBag.Nonce">DevExpress.localization.locale('zh-tw');</script>
    }
    <style nonce="@ViewBag.Nonce">
            :root {
                --orgName: @ViewData["OrgName"];
                --currency-symbol: '@(ViewBag.PriceCurrencySymbol ?? "NT$")';
            }
    </style>
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration
    @if (Configuration.GetValue<bool>("RemoteJs:Enabled", false))
    {
        <script data-consolejs-channel="c54af59e-d006-5fa6-30d5-e2b3f272a9fc" src="https://remotejs.com/agent/agent.js" crossorigin="anonymous"></script>
    }
    <script nonce="@ViewBag.Nonce">
            const RemoteTrackingToken = @Json.Serialize(ViewBag.RemoteTrackingToken ?? "");
            const local = @Html.Raw(L.getAllJsonString());
            const SiteId = @ViewBag.SiteId;
            const SearchWord = @Html.Raw(ViewBag.SearchWord);
            const BackstageUrl = "@ViewBag.BackstageUrl";
            const OAuthSuccess = "@ViewBag.OAuthSuccess";
            const OAuthError = "@ViewBag.OAuthError";
            const RootId = "@ViewBag.RootId";
            const PageId = "@ViewData["Id"]";
            const PageType = "@ViewBag.option";
            const orderPrice = @ViewBag.priceOrder.ToString().ToLower();
            const totalBonus = @Json.Serialize(ViewBag.UserBonus ?? 0);
            const parsedPageId = Number.parseInt(PageId, 10);
            const OrgName = "@ViewData["OrgName"]";
            const PageKey = "@ViewBag.RouterName";
            const priceCurrency = Object.freeze({
                code: @Json.Serialize(ViewBag.PriceCurrencyCode ?? "TWD"),
                symbol: @Json.Serialize(ViewBag.PriceCurrencySymbol ?? "NT$"),
                decimalDigits: @Json.Serialize(ViewBag.PriceCurrencyDecimalDigits ?? 0)
            });
            const formatMoney = function(value) {
                const amount = Number(value);
                if (!Number.isFinite(amount)) {
                    return "";
                }

                const locale = document.documentElement.lang || "zh-TW";
                const formattedAmount = amount.toLocaleString(locale, {
                    minimumFractionDigits: priceCurrency.decimalDigits,
                    maximumFractionDigits: priceCurrency.decimalDigits
                });
                return `${priceCurrency.symbol}${formattedAmount}`;
            };
            window.__LOGIN_STATE__ = @(ViewBag.isLogin == true ? "true" : "false");
            window.SiteId = SiteId;
            window.PageId = Number.isNaN(parsedPageId) ? null : parsedPageId;
            window.CI360 = { notInitOnLoad: true }
            window.totalBonus = totalBonus;
            window.orderPrice = orderPrice;
            window.OrgName = OrgName;
            window.PageKey = PageKey;
            window.CokerCurrency = Object.freeze({
                ...priceCurrency,
                format: formatMoney
            });
            window.RemoteTrackingToken = RemoteTrackingToken;
            window.onload = function() {
                ready();
            }
            const originalAppendChild = Element.prototype.appendChild;
            const originalInsertBefore = Node.prototype.insertBefore;
            const nonce = document.querySelector('meta[name="csp-nonce"]').getAttribute('content');

            // 覆寫 appendChild 方法
            Element.prototype.appendChild = function(child) {
                // child 是否為 undefined
                if (child) {
                    // 檢查是否為 <script> 或 <style> 元素
                    if (child.tagName && (child.tagName === 'SCRIPT' || child.tagName === 'STYLE')) {
                        // 為元素添加 nonce 屬性
                        child.setAttribute('nonce', nonce);
                    }

                    // 調用原始的 appendChild 方法
                    return originalAppendChild.call(this, child);
                }
            };

            // 覆寫 insertBefore 方法
            Node.prototype.insertBefore = function(newNode, referenceNode) {
                // 檢查插入的節點是否為 script 或 style
                if (newNode.tagName === 'SCRIPT' || newNode.tagName === 'STYLE') {
                    // 添加 nonce 屬性
                    newNode.setAttribute('nonce', nonce);
                }

                // 調用原始的 insertBefore 方法
                return originalInsertBefore.call(this, newNode, referenceNode);
            };
    </script>
    @if (!string.IsNullOrEmpty(ViewBag.GA4))
    {
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=@ViewBag.GA4" crossorigin="anonymous"></script>
        <script nonce="@ViewBag.Nonce">
                window.dataLayer = window.dataLayer || [];
                function gtag() { dataLayer.push(arguments); }
                gtag('js', new Date());

                gtag('config', "@ViewBag.GA4");
                @if (!string.IsNullOrEmpty(ViewBag.GoogleAds))
                    {
                        @:gtag('config', '@ViewBag.GoogleAds');
                }
        </script>
    }
    @if (ViewData["google.translate"] != null && !string.IsNullOrEmpty(ViewData["google.translate"]!.ToString() ?? ""))
    {
        <script nonce="@ViewBag.Nonce">
                let isGoogleTranslateInitialized = false;
                let cancelResizeWatch = null;   // 同時間只保留一組觀察，連續切換不會疊加
                let googleTranslateRetries = 0;
                const GOOGLE_TRANSLATE_MAX_RETRIES = 10;

                function triggerResize(quietMs = 200, fallbackMs = 1500) {
                    const header = document.querySelector('header'); // 針對 header
                    if (!header) {
                        // 找不到 header 就直接觸發一次
                        window.dispatchEvent(new Event('resize'));
                        return;
                    }

                    if (cancelResizeWatch) cancelResizeWatch();   // 前一輪還沒結束就先收掉

                    let timer;
                    let fallback;

                    const cleanup = () => {
                        clearTimeout(timer);
                        clearTimeout(fallback);
                        try { mo.disconnect(); } catch { }
                        cancelResizeWatch = null;
                    };

                    // 安靜期到了、或 fallback 到期，兩條路徑只會真的送出一次 resize
                    const done = () => {
                        cleanup();
                        window.dispatchEvent(new Event('resize'));
                    };

                    const mo = new MutationObserver(() => {
                        clearTimeout(timer);
                        timer = setTimeout(done, quietMs);
                    });

                    // 只觀察 header 內部
                    mo.observe(header, {
                        childList: true,      // 子節點增減
                        subtree: true,        // header 裡所有子孫
                        characterData: true,  // 文字內容變化
                        attributes: true      // 屬性改變（例如 style）
                    });

                    // fallback，最多等 fallbackMs
                    fallback = setTimeout(done, fallbackMs);
                    cancelResizeWatch = cleanup;
                }

                document.addEventListener('change', function(e) {
                    if (e.target && e.target.classList && e.target.classList.contains('goog-te-combo')) {
                        triggerResize();
                    }
                });

                function googleTranslateElementInit() {
                    if (isGoogleTranslateInitialized) {
                        console.log("Google Translate is already initialized.");
                        return;
                    }
                    try {
                        if (typeof google !== "undefined" && typeof google.translate !== "undefined" && google.translate.TranslateElement) {
                            new google.translate.TranslateElement({
                                pageLanguage: PAGE_LANG,
                                includedLanguages: '@ViewData["google.translate"]'
                            }, 'google_translate_element');

                            isGoogleTranslateInitialized = true;
                            whenComboReady(function(combo) {
                                combo.title = 'translate';
                                buildTranslateSwitch(combo);
                            });
                            triggerResize();
                        } else if (googleTranslateRetries < GOOGLE_TRANSLATE_MAX_RETRIES) {
                            googleTranslateRetries++;
                            console.warn("Google Translate API is not ready yet. Retrying... (" + googleTranslateRetries + "/" + GOOGLE_TRANSLATE_MAX_RETRIES + ")");
                            setTimeout(googleTranslateElementInit, 1000);
                        } else {
                            console.error("Google Translate API 逾時未就緒，翻譯功能停用");
                        }
                    } catch (error) {
                        console.error("Failed to initialize Google Translate:", error);
                    }
                }


                // 動態加載 Google Translate 腳本
                function loadGoogleTranslateScript() {
                    const script = document.createElement("script");
                    script.src = "https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit";
                    script.async = true;
                    script.defer = true;

                    script.onload = () => {
                        console.log("Google Translate script loaded successfully.");
                    };

                    script.onerror = () => {
                        console.error("Failed to load Google Translate script.");
                    };

                    document.head.appendChild(script);
                }


                // #translate_switch 預設 display:none，需要的站台在自訂 CSS 設成 display:flex 即可開啟；
                // 翻譯目標超過 1 種時會自動切換回下拉選單
                // ViewData["Locale"] 存的是小寫（zh-tw / en），Google 的 option value 是 zh-TW，
                // 兩邊比對和 combo.value 設定都需要一致的大小寫，統一在這裡正規化
                function canonLang(code) {
                    const s = (code || '').trim();
                    const p = s.split('-');
                    return p.length > 1 ? p[0].toLowerCase() + '-' + p[1].toUpperCase() : s.toLowerCase();
                }

                // 與 TranslateElement 的 pageLanguage 共用同一個來源
                const PAGE_LANG = canonLang('@ViewData["Locale"]') || 'zh-TW';

                // 後台勾選的語系清單。注意頁面語系（例如中文(繁體)）勾選的意義不是翻譯目標，
                // 而是讓它成為翻譯後可以切回去的選項——Google 原生就支援原地還原。
                // 沒勾的話翻譯後無路可退，只能靠清 cookie + reload。
                const INCLUDED_LANGS = '@ViewData["google.translate"]'.split(',').map(canonLang).filter(Boolean);
                const TARGET_LANGS = INCLUDED_LANGS.filter(c => c !== PAGE_LANG);
                const CAN_RESTORE_NATIVELY = INCLUDED_LANGS.indexOf(PAGE_LANG) !== -1;
                if (!CAN_RESTORE_NATIVELY) {
                    console.warn('後台翻譯設定未勾選 ' + PAGE_LANG + '，回原文將以重新整理處理');
                }

                // 想顯示語言自稱而不是中文名稱時在這裡覆寫；沒列到的就用 Google 給的名稱
                const TRANSLATE_LABELS = {
                    'zh-TW': '繁體',
                    'zh-CN': '简体',
                };

                // 下拉選單的原語言字樣要跟 Google 自己的「中文 (簡體)」「日文」對齊。
                // Intl.DisplayNames 給不出這個格式（zh-TW→「中文（台灣）」、zh-Hant→「繁體中文」，
                // 括號還是全角），所以在這裡明列；沒列到的語系才退回 Intl。
                const PAGE_LANG_LABELS = {
                    'zh-TW': '中文(繁體)',
                    'zh-CN': '中文(簡體)',
                };

                // 空值選項（原文）顯示成頁面本身的語系名稱，例如「中文 (繁體)」
                function getPageLangLabel() {
                    if (PAGE_LANG_LABELS[PAGE_LANG]) return PAGE_LANG_LABELS[PAGE_LANG];
                    try {
                        return new Intl.DisplayNames([PAGE_LANG], { type: 'language' }).of(PAGE_LANG) || PAGE_LANG;
                    } catch {
                        return PAGE_LANG;
                    }
                }

                // 標籤優先序：TRANSLATE_LABELS 覆寫 → Google 提供的名稱 → Intl → 語系代碼
                function getLangLabel(code, googleText) {
                    const key = code || PAGE_LANG;   // 空值代表原文，改用頁面語系代碼去查表
                    if (TRANSLATE_LABELS[key]) return TRANSLATE_LABELS[key];
                    if (!code) return getPageLangLabel();
                    if (googleText) return googleText.trim();
                    try {
                        return new Intl.DisplayNames([PAGE_LANG], { type: 'language' }).of(code) || code;
                    } catch {
                        return code;
                    }
                }

                // 目前語系（'' 代表原文）。不靠 cookie 即時判斷，避免 Google 寫入延遲
                let currentTranslateLang = '';

                function pickTranslateLang(raw, separator) {
                    const parts = raw.split(separator).filter(Boolean);
                    const lang = canonLang(parts[parts.length - 1] || '');
                    return lang === PAGE_LANG ? '' : lang;   // 翻成自己 = 原文
                }

                function getTranslateLang() {
                    const h = location.hash.match(/googtrans\(([^)]*)\)/);
                    if (h) return pickTranslateLang(decodeURIComponent(h[1]), '|');

                    const c = document.cookie.match(/(?:^|;\s*)googtrans=([^;]*)/);
                    if (c) return pickTranslateLang(decodeURIComponent(c[1]), '/');

                    return '';
                }

                function clearCookieAllDomains(name) {
                    const expire = 'expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
                    const parts = location.hostname.split('.');
                    const domains = [''];
                    for (let i = 0; i <= parts.length - 2; i++) {
                        const d = parts.slice(i).join('.');
                        domains.push(d, '.' + d);
                    }
                    domains.forEach(d => {
                        document.cookie = `${name}=; ${expire}${d ? `; domain=${d}` : ''}`;
                    });
                }

                function clearTranslateCookie() {
                    clearCookieAllDomains('googtrans');
                    clearCookieAllDomains('googtransopt');   // 這行才是第 2 點
                }

                // 後台有勾選頁面語系時，Google 的下拉選單本來就提供「切回頁面語系」，
                // 那是原地還原、不重整。沒勾才退回清 cookie + reload。
                function restoreOriginalLanguage() {
                    if (location.hash.indexOf('googtrans') !== -1) {
                        history.replaceState(null, '', location.pathname + location.search);
                    }

                    const combo = document.querySelector('select.goog-te-combo');
                    if (CAN_RESTORE_NATIVELY && combo) {
                        combo.value = PAGE_LANG;
                        combo.dispatchEvent(new Event('change', { bubbles: true }));
                        currentTranslateLang = '';
                        syncTranslateSwitch();

                        // Google 的 change handler 會把 googtrans 寫成 /zh-TW/zh-TW，
                        // 要排到它之後才清；不清的話下次載入 Google 仍會照 cookie 跑一輪翻譯流程。
                        // 這裡不重載頁面，畫面已經由 Google 原地還原完成。
                        setTimeout(clearTranslateCookie, 0);
                        return;
                    }

                    clearTranslateCookie();
                    location.reload();
                }

                // icon 字型靠文字內容當 ligature（Material Symbols），被翻譯就會變成裸字
                // FA 走 ::before 通常不受影響，一併標記當保險
                const ICON_SELECTOR = [
                    '.material-symbols-outlined',
                    '.material-icons',
                    '[class^="fa-"]',
                    '[class*=" fa-"]'
                ].join(',');

                function markIcon(el) {
                    if (el.classList.contains('notranslate')) return;
                    el.classList.add('notranslate');
                    el.setAttribute('translate', 'no');
                }

                function markIconsNoTranslate(root) {
                    const scope = root || document.body;
                    if (!scope) return;
                    if (scope.nodeType === 1 && scope.matches(ICON_SELECTOR)) markIcon(scope);
                    scope.querySelectorAll(ICON_SELECTOR).forEach(markIcon);
                }

                // ajax 載入的內容（商品列表等）也要補標記。
                // Google 翻譯時會把整頁文字節點包成大量 <font>，那是純文字容器、不可能有 icon
                // （icon 已標 notranslate，Google 根本不會碰），跳過它可以省下翻譯瞬間
                // 成千上萬次的 matches + querySelectorAll 子樹掃描
                function observeNewIcons() {
                    if (!document.body) return;
                    const mo = new MutationObserver(mutations => {
                        for (const m of mutations) {
                            for (const node of m.addedNodes) {
                                if (node.nodeType !== 1) continue;
                                if (node.nodeName === 'FONT') continue;
                                markIconsNoTranslate(node);
                            }
                        }
                    });
                    mo.observe(document.body, { childList: true, subtree: true });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', () => {
                        markIconsNoTranslate();
                        observeNewIcons();
                    });
                } else {
                    markIconsNoTranslate();
                    observeNewIcons();
                }

                // 等 Google 把 select 生出來（TranslateElement 不保證同步完成）
                // 等 Google 把 select 和 option 都生出來（TranslateElement 不保證同步完成）
                function whenComboReady(callback, tries = 40) {
                    const combo = document.querySelector('select.goog-te-combo');
                    if (combo && combo.options.length > 1) { callback(combo); return; }
                    if (tries <= 0) {
                        // Google 沒載入成功（廣告攔截器、CSP、網路）→ 收掉空容器，靜默降級
                        console.warn('goog-te-combo 未就緒，翻譯功能停用');
                        const host = document.getElementById('translate_switch');
                        if (host) host.classList.add('d-none');
                        return;
                    }
                    setTimeout(() => whenComboReady(callback, tries - 1), 250);
                }

                function buildTranslateSwitch(combo) {
                    const host = document.getElementById('translate_switch');
                    if (!host) return;
                    if (host.dataset.built) return;

                    // 站台沒有啟用按鈕（容器仍是 display:none）→ 維持下拉選單
                    if (getComputedStyle(host).display === 'none') return;

                    // 清單來源是後台設定，不是 combo.options。
                    // Google 的 options 是「從目前狀態可切換過去的語言」，翻譯後會變成
                    // 「請選擇語言 + 中文(繁體)」，拿它當翻譯目標清單會誤判。
                                        if (TARGET_LANGS.length === 0) {   // 後台沒設翻譯目標 → 不要留空容器佔位
                        host.classList.add('d-none');
                        return;
                    }

                    // 只有 1 個翻譯目標時用切換鈕，其餘退回下拉選單
                    if (TARGET_LANGS.length !== 1) {
                        host.classList.add('d-none');
                        return;
                    }

                    const code = TARGET_LANGS[0];
                    host.dataset.built = '1';
                    const dropdown = document.getElementById('google_translate_element');
                    if (dropdown) dropdown.classList.add('d-none');
                    buildTranslateToggle(host, { code: code, text: getLangLabel(code, getComboLabel(combo, code)) });
                }

                // 優先沿用 Google 自己給的語系名稱；翻譯狀態下該 option 不在清單裡就取不到，
                // 此時由 getLangLabel 退回 Intl.DisplayNames
                function getComboLabel(combo, code) {
                    const opt = combo.querySelector('option[value="' + code + '"]');
                    return opt ? opt.textContent.trim() : '';
                }

                // 單一目標語系時的切換鈕：文字隨狀態在「目標語系」和「原文」之間翻面
                function buildTranslateToggle(host, lang) {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'notranslate btn btn-sm btn-outline-secondary border-0 px-2';
                    btn.dataset.toggleLang = lang.code;
                    btn.dataset.toggleText = lang.text;
                    host.appendChild(btn);

                    btn.addEventListener('click', function() {
                        if (currentTranslateLang === lang.code) {   // 已翻譯 → 回原文
                            restoreOriginalLanguage();
                            return;
                        }
                        // Google 翻譯後會重建 select，一定要即時查，不能用閉包捕獲的
                        const combo = document.querySelector('select.goog-te-combo');
                        if (!combo) return;
                        combo.value = lang.code;
                        combo.dispatchEvent(new Event('change', { bubbles: true }));
                        currentTranslateLang = lang.code;           // 先更新，不等 cookie
                        syncTranslateSwitch();
                    });

                    currentTranslateLang = getTranslateLang();
                    syncTranslateSwitch();
                }

                function syncTranslateSwitch() {
                    const toggle = document.querySelector('#translate_switch button[data-toggle-lang]');
                    if (!toggle) return;
                    const isTranslated = currentTranslateLang === toggle.dataset.toggleLang;
                    toggle.textContent = isTranslated ? getLangLabel('') : toggle.dataset.toggleText;
                    toggle.setAttribute('aria-pressed', isTranslated ? 'true' : 'false');
                }

                // 加載 Google Translate 腳本並初始化
                loadGoogleTranslateScript();
        </script>
    }
