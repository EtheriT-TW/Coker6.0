@inject EtheriT.Coker.Application.LoginUserData CrawlUser

<div id="SiteCrawlModal" class="modal fade" tabindex="-1" aria-labelledby="siteCrawlTitle"
     data-website-id="@(await CrawlUser.GetWebsiteId())">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="siteCrawlTitle">網站爬蟲匯入</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <form id="siteCrawlForm" class="modal-body">
                <label for="siteCrawlUrl" class="form-label">來源網址</label>
                <input id="siteCrawlUrl" type="url" class="form-control" maxlength="2048"
                       placeholder="https://example.com" required />
                <p class="form-text">
                    先按「偵測列表」找出舊站的列表並預猜是文章還是商品，確認後再按「開始匯入」。
                    匯入會建立主導覽選單、將輪播圖片附加到預設版頭，並以來源頁尾更新預設頁尾，版型儲存後會立即影響前台。
                </p>
                <div id="siteCrawlProgressPanel" class="d-none">
                    <progress id="siteCrawlProgress" class="w-100" max="100" value="0" aria-label="匯入進度"></progress>
                    <p id="siteCrawlMessage" role="status"></p>
                    <p id="siteCrawlSummary" class="mb-1"></p>
                    <ul id="siteCrawlErrors" class="mb-0"></ul>
                </div>
                <section id="siteCrawlListsPanel" class="d-none mt-3" aria-labelledby="siteCrawlListsTitle">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <h3 id="siteCrawlListsTitle" class="fs-6 fw-bold mb-0 me-auto">確認列表類型</h3>
                        <span id="siteCrawlListsCount" class="small text-body-secondary" aria-live="polite"></span>
                        <button type="button" id="siteCrawlAllArticles" class="btn btn-outline-secondary btn-sm">全部設為文章</button>
                        <button type="button" id="siteCrawlAllProducts" class="btn btn-outline-secondary btn-sm">全部設為商品</button>
                    </div>
                    <p class="form-text mt-0">
                        「商品」的列表會建在商品管理的商品列表（時價、無規格），列表頁改用勾選「商品匯入目錄」用途的元件顯示。
                        舊系統購物商品已鎖定為商品。
                    </p>
                    <p id="siteCrawlListsStale" class="text-warning-emphasis small d-none" role="status">來源網址已變更，請重新偵測。</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">列表</th>
                                    <th scope="col" class="d-none d-sm-table-cell text-nowrap">舊站類型</th>
                                    <th scope="col" class="text-nowrap">匯入成</th>
                                    <th scope="col" class="d-none d-md-table-cell">判斷依據</th>
                                </tr>
                            </thead>
                            <tbody id="siteCrawlLists"></tbody>
                        </table>
                    </div>
                </section>
                <p id="siteCrawlError" class="text-danger mt-2 mb-0" role="alert"></p>
            </form>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">確認</button>
                <button type="button" id="siteCrawlCancel" class="btn btn-outline-danger d-none">取消任務</button>
                <button type="submit" id="siteCrawlDetect" form="siteCrawlForm" class="btn btn-outline-primary" disabled>偵測列表</button>
                <button type="button" id="siteCrawlStart" class="btn btn-primary" disabled>開始匯入</button>
            </div>
        </div>
    </div>
</div>
