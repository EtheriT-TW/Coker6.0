@model EtheriT.Coker.Application.Shared.Dto.MailTemplate.ForgetTemplateResultDto;
<style>
    .text-size1 { font-size: 1rem; }
    .d-flex { display: flex; }
    .text-bold { font-weight: bold; }
    .text-red { color: red; }
    .text-gray { color: gray; }
</style>
@{
    var url = $"{Model.WebsiteLink}?useraction=passwordforget&forgetid={Model.ForgetID}";
}
<div class='text-size1'>
    <h2 class='text-red'>Hello, valued member!</h2>
    <hr />
    <div>Please review the important information below.</div>
    <br />
    <div class='d-flex text-bold'><div>Your account:</div><u>@Model.Email</u></div>
    <br />
    <div class='text-bold'>Password reset link</div>
    <a href='@url' title='Reset password'>@url</a>
    <div class='text-gray'>Use the link above to reset your password.</div>
    <div class='text-gray'>This link can only be used once and expires at @Model.ForgeIDSendDate.ToString("yyyy/MM/dd HH:mm").</div>
    <br />
    <hr />
    <div class='text-bold text-red'>This password reset notification was sent automatically. Please do not reply.</div>
    <div class='text-bold text-red'>Customer service will never ask you to change your account or make an ATM or bank transfer.</div>
    <div class='text-bold text-red'>If this happens, contact your local anti-fraud service immediately.</div>
</div>
