<link rel="stylesheet" href="~/css/Components/WebApplication.min.css" asp-append-version="true" />
<script src="~/js/Components/WebApplication.min.js" asp-append-version="true"></script>

<div class="modal fade" id="switchApp" tabindex="-1" role="dialog" aria-labelledby="switchAppLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header px-4">
                <h5 class="modal-title" id="switchAppLabel">選擇管理站台</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="website-search-panel d-none mb-4">
                    <div id="websiteSearchBox"></div>
                    <small class="website-result-count text-muted" aria-live="polite"></small>
                </div>
                <div class="website-loading py-5 text-center d-none" role="status">
                    <div class="spinner-border text-primary" aria-hidden="true"></div>
                    <div class="mt-2 text-muted">正在載入網站清單…</div>
                </div>
                <div class="website-load-error alert alert-danger d-none" role="alert">
                    網站清單載入失敗，請關閉視窗後再試一次。
                </div>
                <div class="website-no-result py-5 text-center text-muted d-none">
                    <span class="material-symbols-outlined website-no-result-icon">search_off</span>
                    <div>找不到符合條件的網站</div>
                </div>
                <div id="selectedWebsite" class="d-none" data-id="">
                    <span data-key="name"></span>
                </div>
                <template id="TemplateApp">
                    <div class="col-xl-2 col-lg-3 col-6 mb-4">
                        <div data-key="Id" class="card h-100 webitem" data-id="" role="button" tabindex="0">
                            <button type="button" class="website-pin" title="置頂網站" aria-label="置頂網站" aria-pressed="false">
                                <span class="material-symbols-outlined md-18">push_pin</span>
                            </button>
                            <div class="card-body text-center">
                                <img data-key="image" class="webicon" src="/favicon.ico" alt="Icon" />
                                <p data-key="name" class="weight-400 m-0 webkit-box line-1"></p>
                                <small data-key="description" class="weight-300 text-start text-muted webkit-box line-2"></small>
                            </div>
                        </div>
                    </div>
                </template>
                <div class="row align-items-stretch app-switcher"></div>
                <ul class="page_btn d-none justify-content-center pagination mb-0"></ul>
            </div>
            <div class="modal-footer px-4">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="button" class="btn btn-primary switch" data-bs-dismiss="modal" disabled>確認</button>
            </div>
        </div>
    </div>
</div>
