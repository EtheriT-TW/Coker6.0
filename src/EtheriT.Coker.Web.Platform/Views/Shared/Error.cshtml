@model ErrorViewModel
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>系統錯誤 - Coker Platform</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="access-page">
    <main class="access-card">
        <span class="access-code">500</span>
        <h1>Platform 暫時無法處理這項要求</h1>
        <p>請稍後再試。若問題持續發生，請提供要求編號給系統管理員。</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>要求編號：</strong><code>@Model.RequestId</code></p>
        }
    </main>
</body>
</html>
