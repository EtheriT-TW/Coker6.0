@using DevExtreme.AspNet.Mvc
@model EtheriT.Coker.Web.MVC.Models.FileManagement.IndexModel

@{
    ViewData["Title"] = "FileManagement";
}

<div class="file-management-modebar" role="navigation" aria-label="檔案管理檢視">
    <button type="button" class="active" data-file-mode="files">所有檔案</button>
    <button type="button" data-file-mode="unreferenced">查無引用</button>
    <button type="button" data-file-mode="recycle">資源回收桶</button>
</div>

<div id="filemanager-container">
    @(Html.DevExtreme().FileManager()
        .ID("file-manager")
        .Height("85vh")
        .FileSystemProvider(provider => provider.Remote()
                                                .Url("/api/FileManagement/FileSystem")
                                                .BeforeAjaxSend("onBeforeAjaxSendFileSystemRequest"))
        .Permissions(permissions =>
        {
            // uncomment the code below to enable file/folder management
            // permissions.Copy(true);
            permissions.Download(true);
            permissions.Create(true);
            permissions.Move(true);
            permissions.Delete(true);
            permissions.Rename(true);
            permissions.Upload(true);
        })

        .AllowedFileExtensions(Model.AllowFileExtension)
        .ItemView(itemView =>
        {
            itemView.Mode(FileManagerItemViewMode.Thumbnails);
            itemView.Details(details =>
            {
                details.Columns(columns =>
                {
                    columns.Add().DataField("name").Caption("實體檔名");
                    columns.Add().DataField("OriginalFileName").Caption("上傳檔名");
                    columns.Add()
                        .DataField("ReferenceCount")
                        .Caption("引用次數")
                        .Width(110);
                    columns.Add().DataField("size");
                    columns.Add().DataField("dateModified").DataType(GridColumnDataType.DateTime).Width(200);
                });
            })
            .ShowParentFolder(false);
        })
        .CustomizeDetailColumns("fileManager_customizeDetailColumns")
        .Toolbar(toolbar => {
            toolbar.Items(items => {
                items.Add().Name("create").Text("新增資料夾");
                items.Add().Name("upload").Text("上傳檔案");
                items.Add()
                    .Name("searchBoxWidget")
                    .Location(ToolbarItemLocation.Before)
                    .Widget(w => w.TextBox()
                        .ID("fileManagerSearchBox")
                        .Placeholder("依檔名搜尋...")
                        .Mode(TextBoxMode.Search)
                        .ShowClearButton(true)
                        .Width(250)
                        .OnValueChanged("fileManagerSearch_onValueChanged")
                        .ElementAttr("style", "")
                    )
                    .LocateInMenu(ToolbarItemLocateInMenuMode.Never);

                items.Add().Name("refresh").Text("重新整理");
                items.Add().Name("switchView");
            });
        })
        .OnContentReady("fileManager_onContentReady")
        .OnSelectedFileOpened("fileManager_onSelectedFileOpened")
        .OnItemDeleting("fileManager_onItemDeleting")
        .CustomizeThumbnail("fileManager_onCustomizeThumbnail")
        .OnFileUploading("fileManager_onFileUploading")
    )

</div>

<section id="file-cleanup-panel" class="file-cleanup-panel" hidden>
    <div class="file-cleanup-toolbar">
        <div>
            <h2 id="file-cleanup-title">查無引用</h2>
            <p id="file-cleanup-description"></p>
        </div>
        <div class="file-cleanup-actions">
            <div id="file-cleanup-scan"></div>
            <div id="file-cleanup-recycle-selected"></div>
            <div id="file-cleanup-restore-selected"></div>
            <div id="file-cleanup-delete-selected"></div>
            <div id="file-cleanup-refresh"></div>
        </div>
    </div>
    <div id="file-cleanup-task" class="file-cleanup-task" hidden>
        <div class="file-cleanup-task-header">
            <span id="file-cleanup-task-message">背景作業準備中…</span>
            <span id="file-cleanup-task-percent">0%</span>
        </div>
        <div id="file-cleanup-task-progress"></div>
        <div class="file-cleanup-task-hint">作業由伺服器背景執行，可離開此頁面；返回時會自動接續顯示進度。</div>
    </div>
    <div id="file-cleanup-loading" class="file-cleanup-message">資料載入中…</div>
    <div id="file-cleanup-empty" class="file-cleanup-message" hidden></div>
    <div id="file-cleanup-grid" aria-live="polite" hidden></div>
</section>

@(Html.DevExtreme().Popup()
    .ID("photo-popup")
    .MaxHeight(600)
    .OnContentReady("popup_photo_onContentReady")
    .HideOnOutsideClick(true)
    .ShowCloseButton(true))

<div id="file-reference-popup">
    <div id="file-reference-summary" class="file-reference-summary"></div>
    <div id="file-reference-grid"></div>
</div>

<style>
    .file-management-modebar { display: flex; gap: .5rem; margin-bottom: 1rem; }
    .file-management-modebar button {
        border: 1px solid #adb5bd; border-radius: .35rem; background: #fff; padding: .45rem .8rem;
    }
    .file-management-modebar button.active { color: #fff; background: #0d6efd; border-color: #0d6efd; }
    .file-cleanup-panel { width: min(100%, 1440px); min-height: 70vh; margin: 0 auto; padding: 0 .75rem 2rem; }
    .file-cleanup-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; margin-bottom: 1rem; padding: .25rem 0; }
    .file-cleanup-toolbar h2 { margin: 0 0 .35rem; font-size: 1.35rem; }
    .file-cleanup-toolbar p { margin: 0; color: #6c757d; }
    .file-cleanup-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: .5rem; white-space: nowrap; }
    .file-cleanup-actions .dx-button { min-width: 38px; }
    .file-cleanup-task { margin: 0 0 1rem; padding: .85rem 1rem; border: 1px solid #d8dee6; border-radius: .4rem; background: #fff; }
    .file-cleanup-task-header { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: .55rem; }
    .file-cleanup-task-hint { margin-top: .45rem; color: #6c757d; font-size: .85rem; }
    #file-cleanup-grid { background: #fff; }
    #file-cleanup-grid .dx-datagrid-headers .dx-header-row > td { font-weight: 600; }
    #file-cleanup-grid .dx-command-select { width: 54px !important; min-width: 54px !important; }
    .file-cleanup-preview { width: 72px; height: 54px; object-fit: cover; border-radius: .25rem; background: #eee; cursor: zoom-in; }
    .file-cleanup-preview:focus { outline: 2px solid #0d6efd; outline-offset: 2px; }
    .file-cleanup-file { min-width: 0; padding: .25rem 0; }
    .file-cleanup-path { overflow-wrap: anywhere; color: #6c757d; font-size: .85rem; }
    .file-cleanup-reason { margin-top: .25rem; font-size: .85rem; }
    .file-cleanup-message { padding: 2rem; text-align: center; color: #6c757d; }
    .file-cleanup-row-actions { display: flex; justify-content: center; gap: .2rem; }
    .file-cleanup-row-actions .dx-button { min-width: 32px; }
    .photo-popup-content { display: flex; align-items: center; justify-content: center; overflow: auto; }
    .photo-popup-image { display: block; max-width: 100%; max-height: 520px; object-fit: contain; }
    .file-reference-summary { margin-bottom: .75rem; color: #495057; }
    #file-reference-grid .dx-datagrid-headers .dx-header-row > td { font-weight: 600; }
    .file-reference-count-button {
        min-width: 32px; padding: .15rem .45rem; border: 0; border-radius: .25rem;
        color: #0d6efd; background: transparent; text-decoration: underline; cursor: pointer;
    }
    .file-reference-count-button:hover, .file-reference-count-button:focus {
        color: #fff; background: #0d6efd; text-decoration: none; outline: none;
    }
    @@media (max-width: 900px) {
        .file-cleanup-toolbar { align-items: stretch; flex-direction: column; }
        .file-cleanup-actions { justify-content: flex-start; }
    }
</style>

<script>
    function onBeforeAjaxSendFileSystemRequest({ headers, formData, xhrFields }) {
        var searchBox = $("#fileManagerSearchBox").dxTextBox("instance");
        var searchTerm = "";
        if (searchBox) {
            searchTerm = searchBox.option("value");
            if (searchTerm === "") {
                return;
            }
            else {
                formData.searchValue = searchTerm;
            }
        }
    }

    function fileManagerSearch_onValueChanged(e) {
        var fileManager = $("#file-manager").dxFileManager("instance");
        var searchBox = $("#fileManagerSearchBox").dxTextBox("instance");
        // 根據是否有輸入值來設定背景色
        if (e.value && e.value.trim() !== "") {
            // 有輸入值時設定深黃色背景
            searchBox.element().find("input").css("background-color", "#ffc107");
        } else {
            // 沒有輸入值時恢復預設背景
            searchBox.element().find("input").css("background-color", "");
        }

        if (fileManager) {
            fileManager.refresh();
        }
    }

    function fileManager_onItemDeleting(e) {
        if (e.item && !e.item.isDirectory) {
            // 取得要刪除的檔案路徑
            var filePath = e.item.relativeName || e.item.name;

            // 使用同步 AJAX 檢查檔案是否有關聯
            var hasBindings = false;
            var checkSuccess = false;

            $.ajax({
                url: '/api/FileManagement/CheckFileHasBindings',
                type: 'POST',
                contentType: 'application/json',
                headers: co.Data.Header,
                data: JSON.stringify(filePath),
                // 設定為同步請求
                async: false,
                success: function (result) {
                    hasBindings = result;
                    checkSuccess = true;
                },
                error: function () {
                    // AJAX 錯誤時，為安全起見，假設有關聯
                    hasBindings = true;
                    checkSuccess = true;
                }
            });

            // 如果檢查成功且檔案有關聯，則詢問使用者確認
            if (checkSuccess && hasBindings) {
                co.sweet.warn(
                    "無法移至資源回收桶",
                    `「${escapeFileHtml(e.item.name)}」目前正被系統使用中。`);
                e.cancel = true;
                e.errorText = "檔案仍被引用";
                return;
            }
            e.cancel = co.sweet.confirmAsync(
                "移至資源回收桶",
                `確定將「${escapeFileHtml(e.item.name)}」移至資源回收桶嗎？`,
                "確定移動",
                "取消"
            ).then(confirmed => !confirmed);
        }
    }

    function fileManager_onSelectedFileOpened(e) {
        const fileExtension = e.file.name.split('.').pop().toLowerCase();
        const imageExtensions = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'avif', 'svg'];
        const displayFileName = e.file.dataItem.OriginalFileName
            ? `${e.file.name} (${e.file.dataItem.OriginalFileName})`
            : e.file.name;

        // 如果 DownloadFileName 為空，則實體檔案路徑
        // 如果 DownloadFileName 有值，則需要把含OrgName的路徑補上
        const imageSource = (e.file.dataItem.DownloadFileName ? e.file.dataItem.DownloadFileName.replace('/upload/', @Html.Raw($"'{Model.DownloadPathAppendOrgName.ToString()}'")) : null) ||
                            @Html.Raw($"'{Model.DownloadPathAppendOrgName.ToString()}'") +
                                         (e.file.parentPath ? e.file.parentPath + '/' : '') +
                                          e.file.dataItem.name;

        if (imageExtensions.includes(fileExtension)) {
            // 圖片檔案的處理：使用DevExtreme().Popup()顯示
            var popup = $("#photo-popup").dxPopup("instance");
            popup.option({
                "title": displayFileName,
                "contentTemplate": "<img src=\"" + imageSource + "\" class=\"photo-popup-image\" />"
            });
            popup.show();
        } else {
            // 非圖片檔案：一律開啟新視窗
            window.open(imageSource, '_blank');
        }
    }

    function fileManager_onContentReady(e) {
        var fileManagerInstance = $("#file-manager").dxFileManager("instance");
        var acceptString = "@Html.Raw(string.Join(",", Model.AllowContentType))";

        // 設定上傳檔案的類型(client端)
        fileManagerInstance._editing._fileUploader._uploaderInfos.forEach(u => u.fileUploader.option('accept', acceptString));

        // 監聽檔案管理器的變化，為新載入的縮圖加入 lazy loading 和 alt
        var observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                mutation.addedNodes.forEach(function(node) {
                    if (node.nodeType === 1) { // Element node
                        $(node).find(".dx-filemanager-item-custom-thumbnail").each(function() {
                            var $img = $(this);
                            var fileName = $img.closest('.dx-filemanager-thumbnails-item').find('.dx-filemanager-thumbnails-item-name').text();
                            $img.attr("loading", "lazy");
                            $img.attr("alt", fileName + "(縮圖)");
                        });
                    }
                });
            });
        });

        observer.observe(document.getElementById("file-manager"), {
            childList: true,
            subtree: true
        });
    }

    function popup_photo_onContentReady(e) {
        var $contentElement = e.component.content();
        $contentElement.addClass("photo-popup-content");
    }

    function fileManager_onCustomizeThumbnail(fileManagerItem) {
        return fileManagerItem.dataItem ? fileManagerItem.dataItem.thumbnailUrl : null;
    }

    function fileManager_onFileUploading(e) {
        // 建立一個新的 Promise
        e.cancel = new Promise((resolve) => {
            // 取得目前目錄路徑和檔案名稱
            var directoryPath = e.destinationDirectory.path || "";
            var fileName = e.fileData.name;

            // 執行 AJAX 檢查檔案是否已存在
            $.ajax({
                url: '/api/FileManagement/CheckFileExists',
                type: 'POST',
                contentType: 'application/json',
                headers: co.Data.Header,
                data: JSON.stringify({
                    directoryPath: directoryPath,
                    fileName: fileName
                }),
                success: function (fileExists) {
                    if (fileExists) {
                        co.sweet.confirm(
                            "覆蓋既有檔案",
                            `檔案「${escapeFileHtml(fileName)}」已存在，是否要覆蓋？`,
                            "確定覆蓋",
                            "取消",
                            function () {
                                resolve(false);
                            },
                            function () {
                                resolve({
                                    cancel: true,
                                    errorText: "已取消上傳，檔案未被覆蓋"
                                });
                            });
                    } else {
                        // 檔案不存在，直接上傳
                        resolve(false); // false 表示不取消上傳
                    }
                },
                error: function () {
                    // 出錯時，為安全起見，允許上傳
                    resolve(false);
                }
            });
        });
    }

    function fileManager_customizeDetailColumns(columns) {
        if (!Array.isArray(columns)) {
            return columns || [];
        }
        const referenceColumn = columns.find(column => column.dataField === "ReferenceCount");
        if (referenceColumn) {
            referenceColumn.cellTemplate = fileManager_referenceCellTemplate;
        }
        return columns;
    }

    function fileManager_referenceCellTemplate(container, options) {
        const fileItem = options.data?.fileItem || {};
        const row = fileItem.dataItem || {};
        const count = Number(row.ReferenceCount ?? options.value ?? 0);
        const fileUploadId = Number(row.FileUploadId || 0);
        const fileName = row.OriginalFileName || fileItem.name || "檔案";
        $("<button>", {
            type: "button",
            class: "file-reference-count-button",
            text: count,
            title: "點擊查看引用位置",
            "aria-label": `查看 ${fileName} 的引用位置`
        }).on("click", event => {
            event.preventDefault();
            event.stopPropagation();
            fileManager_openReferences(fileUploadId, fileName);
        }).appendTo(container);
    }

    function fileManager_openReferences(fileUploadId, fileName) {
        if (!fileUploadId) {
            co.sweet.warn("查看引用", "這個實體檔案尚未建立 FileUpload 紀錄，請先執行背景掃描。");
            return;
        }

        $.get("/api/FileManagement/FileReferences", { fileUploadId })
            .done(result => {
                const references = result.references || [];
                $("#file-reference-summary").text(
                    `總引用次數：${result.totalOccurrenceCount || 0}；引用位置：${references.length} 處。`);
                const grid = getFileReferenceGrid();
                grid.option("dataSource", references);
                const popup = getFileReferencePopup();
                popup.option("title", `引用資訊：${fileName}`);
                popup.show();
            })
            .fail(xhr => co.sweet.warn(
                "無法讀取引用資訊",
                xhr?.responseJSON?.message || xhr?.responseText || "請稍後再試。"));
    }

    let fileReferencePopupInstance = null;
    let fileReferenceGridInstance = null;

    function getFileReferencePopup() {
        if (!fileReferencePopupInstance) {
            fileReferencePopupInstance = $("#file-reference-popup").dxPopup({
                width: "min(1100px, 94vw)",
                height: "min(680px, 88vh)",
                showCloseButton: true,
                hideOnOutsideClick: true,
                dragEnabled: true
            }).dxPopup("instance");
        }
        return fileReferencePopupInstance;
    }

    function getFileReferenceGrid() {
        if (!fileReferenceGridInstance) {
            fileReferenceGridInstance = $("#file-reference-grid").dxDataGrid({
                dataSource: [],
                showBorders: true,
                rowAlternationEnabled: true,
                hoverStateEnabled: true,
                wordWrapEnabled: true,
                columnAutoWidth: true,
                columnHidingEnabled: true,
                noDataText: "目前沒有已記錄的引用。",
                paging: { enabled: false },
                scrolling: { mode: "virtual" },
                columns: [
                    { dataField: "sourceName", caption: "引用來源", minWidth: 180 },
                    { dataField: "sourceType", caption: "類型", width: 150 },
                    {
                        dataField: "sourceState",
                        caption: "狀態",
                        width: 95,
                        customizeText: cell => ({
                            Draft: "草稿", Published: "已發布", Newsletter: "電子報",
                            Current: "目前設定", Binding: "檔案綁定"
                        })[cell.value] || cell.value
                    },
                    { dataField: "sourceField", caption: "欄位", width: 140 },
                    { dataField: "occurrenceCount", caption: "次數", width: 75, alignment: "right" },
                    { dataField: "path", caption: "路徑", minWidth: 260 }
                ]
            }).dxDataGrid("instance");
        }
        return fileReferenceGridInstance;
    }

    let fileCleanupMode = "unreferenced";
    let fileCleanupItems = [];
    let fileCleanupTaskRunning = false;
    let fileCleanupTaskTimer = null;

    const fileCleanupTaskProgress = $("#file-cleanup-task-progress").dxProgressBar({
        min: 0,
        max: 100,
        value: 0,
        showStatus: false
    }).dxProgressBar("instance");

    const fileCleanupGrid = $("#file-cleanup-grid").dxDataGrid({
        dataSource: [],
        keyExpr: "id",
        showBorders: true,
        showRowLines: true,
        rowAlternationEnabled: true,
        hoverStateEnabled: true,
        columnAutoWidth: true,
        columnHidingEnabled: true,
        wordWrapEnabled: true,
        noDataText: "目前沒有資料。",
        searchPanel: {
            visible: true,
            width: 320,
            placeholder: "搜尋檔名、路徑或原因…",
            highlightCaseSensitive: false,
            highlightSearchText: true,
            searchVisibleColumnsOnly: false
        },
        filterRow: {
            visible: true,
            applyFilter: "auto"
        },
        headerFilter: {
            visible: true
        },
        selection: {
            mode: "multiple",
            showCheckBoxesMode: "always",
            selectAllMode: "allPages"
        },
        paging: { pageSize: 20 },
        pager: {
            visible: true,
            showInfo: true,
            showPageSizeSelector: true,
            allowedPageSizes: [10, 20, 50, 100]
        },
        columns: [
            {
                caption: "預覽",
                width: 105,
                alignment: "center",
                allowFiltering: false,
                allowSorting: false,
                hidingPriority: 1,
                cellTemplate(container, options) {
                    const item = options.data;
                    const isImage = String(item.contentType || "").toLowerCase().startsWith("image/");
                    if (!isImage || !item.physicalFileExists) {
                        $(container).text("—");
                        return;
                    }
                    const image = $("<img>", {
                        class: "file-cleanup-preview",
                        loading: "lazy",
                        src: item.url,
                        alt: item.name || "檔案預覽",
                        title: "點擊放大預覽",
                        tabindex: 0,
                        role: "button"
                    }).appendTo(container);
                    image.on("click", () => openFileCleanupPreview(item));
                    image.on("keydown", event => {
                        if (event.key !== "Enter" && event.key !== " ") return;
                        event.preventDefault();
                        openFileCleanupPreview(item);
                    });
                }
            },
            {
                caption: "檔案",
                minWidth: 320,
                hidingPriority: 0,
                allowSearch: true,
                calculateCellValue: item => `${item.name || ""} ${item.path || ""} ${item.reason || ""}`,
                cellTemplate(container, options) {
                    const item = options.data;
                    const content = $("<div>", { class: "file-cleanup-file" }).appendTo(container);
                    $("<div>").text(item.name || "—").appendTo(content);
                    $("<div>", { class: "file-cleanup-path" }).text(item.path || "—").appendTo(content);
                    if (item.reason) {
                        $("<div>", { class: "file-cleanup-reason" }).text(item.reason).appendTo(content);
                    }
                }
            },
            {
                dataField: "size",
                caption: "大小",
                width: 105,
                hidingPriority: 4,
                customizeText: cellInfo => formatFileSize(cellInfo.value)
            },
            {
                dataField: "creationTime",
                caption: "檔案建立時間",
                dataType: "datetime",
                width: 185,
                hidingPriority: 3,
                cellTemplate: (container, options) => $(container).text(formatFileDate(options.value))
            },
            {
                dataField: "cleanupDate",
                caption: "發現時間",
                dataType: "datetime",
                width: 185,
                hidingPriority: 2,
                cellTemplate: (container, options) => $(container).text(formatFileDate(options.value))
            },
            {
                caption: "操作",
                width: 105,
                alignment: "center",
                allowFiltering: false,
                allowSorting: false,
                fixed: true,
                fixedPosition: "right",
                cellTemplate(container, options) {
                    createCleanupRowActions(container, options.data);
                }
            }
        ],
        onSelectionChanged: updateCleanupSelectionActions
    }).dxDataGrid("instance");

    createCleanupToolbarButton("file-cleanup-scan", "search", "立即背景掃描", startFileReferenceScan);
    createCleanupToolbarButton("file-cleanup-recycle-selected", "trash", "將選取檔案移至資源回收桶", recycleSelectedUnreferencedFiles, "danger");
    createCleanupToolbarButton("file-cleanup-restore-selected", "revert", "還原選取檔案", restoreSelectedRecycleFiles);
    createCleanupToolbarButton("file-cleanup-delete-selected", "remove", "永久刪除／清除選取項目", deleteSelectedRecycleFiles, "danger");
    createCleanupToolbarButton("file-cleanup-refresh", "refresh", "重新整理", loadCleanupItems);
    resumeFileCleanupTask();

    document.querySelectorAll("[data-file-mode]").forEach(button => {
        button.addEventListener("click", () => switchFileManagementMode(button.dataset.fileMode));
    });

    function createCleanupToolbarButton(id, icon, hint, onClick, type) {
        $(`#${id}`).dxButton({
            icon,
            hint,
            type: type || "normal",
            stylingMode: "outlined",
            elementAttr: { "aria-label": hint, title: hint },
            onClick
        });
    }

    function cleanupButton(id) {
        return $(`#${id}`).dxButton("instance");
    }

    function switchFileManagementMode(mode) {
        document.querySelectorAll("[data-file-mode]").forEach(button => {
            button.classList.toggle("active", button.dataset.fileMode === mode);
        });
        const isFiles = mode === "files";
        document.getElementById("filemanager-container").hidden = !isFiles;
        document.getElementById("file-cleanup-panel").hidden = isFiles;
        if (isFiles) {
            $("#file-manager").dxFileManager("instance")?.refresh();
            return;
        }
        fileCleanupMode = mode;
        const isRecycle = mode === "recycle";
        document.getElementById("file-cleanup-title").textContent = isRecycle ? "資源回收桶" : "查無引用";
        document.getElementById("file-cleanup-description").textContent = isRecycle
            ? "檔案已移至前台無法讀取的隔離區，可還原；超過保留期限後才會永久清除。"
            : "背景掃描確認未出現在檔案綁定、草稿、發布內容、CSS 或版型中的檔案。";
        fileCleanupGrid.columnOption("cleanupDate", "caption", isRecycle ? "刪除時間" : "發現時間");
        fileCleanupGrid.clearFilter();
        fileCleanupGrid.clearSelection();
        $("#file-cleanup-scan").toggle(!isRecycle);
        $("#file-cleanup-recycle-selected").toggle(!isRecycle);
        $("#file-cleanup-restore-selected").toggle(isRecycle);
        $("#file-cleanup-delete-selected").toggle(isRecycle);
        updateCleanupSelectionActions();
        loadCleanupItems();
        if (!document.getElementById("file-cleanup-task").hidden)
            fileCleanupTaskProgress.repaint();
    }

    function loadCleanupItems() {
        const isRecycle = fileCleanupMode === "recycle";
        const loading = document.getElementById("file-cleanup-loading");
        const empty = document.getElementById("file-cleanup-empty");
        const gridElement = document.getElementById("file-cleanup-grid");
        loading.hidden = false;
        empty.hidden = true;
        gridElement.hidden = true;
        fileCleanupItems = [];
        fileCleanupGrid.clearSelection();
        fileCleanupGrid.option("dataSource", []);
        $.ajax({
            url: isRecycle
                ? "/api/FileManagement/RecycleBinFiles"
                : "/api/FileManagement/UnreferencedFiles",
            type: "GET",
            headers: co.Data.Header
        }).done(items => {
            loading.hidden = true;
            if (!items.length) {
                empty.textContent = isRecycle ? "資源回收桶目前沒有檔案。" : "目前沒有查無引用的候選檔案。";
                empty.hidden = false;
                return;
            }
            fileCleanupItems = items.map(item => ({
                ...item,
                cleanupDate: isRecycle ? item.deletionTime : item.detectedTime
            }));
            fileCleanupGrid.option("dataSource", fileCleanupItems);
            gridElement.hidden = false;
            fileCleanupGrid.updateDimensions();
        }).fail(xhr => {
            loading.hidden = true;
            empty.textContent = getFileActionError(xhr, "讀取檔案清單失敗。");
            empty.hidden = false;
        });
    }

    function createCleanupRowActions(container, item) {
        const actions = $("<div>", { class: "file-cleanup-row-actions" }).appendTo(container);
        if (fileCleanupMode === "recycle") {
            createCleanupRowButton(actions, "revert", "還原", () => restoreRecycleFile(item));
            createCleanupRowButton(
                actions,
                "remove",
                item.isQuarantined ? "永久刪除" : "清除紀錄",
                () => permanentlyDeleteFile(item),
                "danger");
            return;
        }
        createCleanupRowButton(actions, "trash", "移至資源回收桶", () => recycleUnreferencedFile(item), "danger");
    }

    function openFileCleanupPreview(item) {
        if (!item.previewUrl) return;
        const popup = $("#photo-popup").dxPopup("instance");
        popup.option({
            title: item.name || "圖片預覽",
            contentTemplate(contentElement) {
                $("<img>", {
                    class: "photo-popup-image",
                    src: item.previewUrl,
                    alt: item.name || "圖片預覽"
                }).appendTo(contentElement);
            }
        });
        popup.show();
    }

    function createCleanupRowButton(container, icon, hint, onClick, type) {
        $("<div>").appendTo(container).dxButton({
            icon,
            hint,
            type: type || "normal",
            stylingMode: "text",
            elementAttr: { "aria-label": hint, title: hint },
            onClick
        });
    }

    function updateCleanupSelectionActions() {
        const hasSelection = fileCleanupGrid.getSelectedRowKeys().length > 0;
        cleanupButton("file-cleanup-recycle-selected").option("disabled", !hasSelection || fileCleanupTaskRunning);
        cleanupButton("file-cleanup-restore-selected").option("disabled", !hasSelection || fileCleanupTaskRunning);
        cleanupButton("file-cleanup-delete-selected").option("disabled", !hasSelection || fileCleanupTaskRunning);
    }

    function startFileReferenceScan() {
        const button = cleanupButton("file-cleanup-scan");
        button.option("disabled", true);
        $.ajax({
            url: "/api/FileManagement/StartReferenceScan",
            type: "POST",
            headers: co.Data.Header
        }).done(() => {
            DevExpress.ui.notify("背景掃描已排程，完成後請按重新整理。", "success", 3500);
        }).fail(xhr => {
            DevExpress.ui.notify(getFileActionError(xhr, "無法啟動背景掃描。"), "error", 4000);
        }).always(() => { button.option("disabled", false); });
    }

    async function recycleUnreferencedFile(item) {
        const confirmed = await co.sweet.confirmAsync(
            "移至資源回收桶",
            `確定將「${escapeFileHtml(item.name)}」及其大／中／縮圖移至資源回收桶嗎？`,
            "確定移動",
            "取消");
        if (!confirmed) return;
        postFileAction("MoveToRecycleBin", item.id, "已移至資源回收桶。");
    }

    async function recycleSelectedUnreferencedFiles() {
        const items = fileCleanupGrid.getSelectedRowsData();
        if (!items.length) return;
        const confirmed = await co.sweet.confirmAsync(
            "批次移至資源回收桶",
            `確定將選取的 ${items.length} 筆檔案及其大／中／縮圖交由背景處理嗎？系統會先重新檢查引用。`,
            "確定移動",
            "取消");
        if (!confirmed) return;
        startRecycleBackgroundTask(items);
    }

    function startRecycleBackgroundTask(items) {
        setCleanupActionButtonsDisabled(true);
        $.ajax({
            url: "/api/FileManagement/StartMoveSelectedToRecycleBin",
            type: "POST",
            contentType: "application/json",
            headers: co.Data.Header,
            data: JSON.stringify(items.map(item => item.id))
        }).done(result => {
            DevExpress.ui.notify("背景清理已排程，可離開此頁面。", "success", 3500);
            monitorFileCleanupTask(result.taskId);
        }).fail(xhr => {
            setCleanupActionButtonsDisabled(false);
            updateCleanupSelectionActions();
            DevExpress.ui.notify(getFileActionError(xhr, "無法啟動背景清理。"), "error", 4500);
        });
    }

    function resumeFileCleanupTask() {
        $.ajax({
            url: "/api/FileManagement/FileCleanupTask",
            type: "GET",
            headers: co.Data.Header
        }).done(task => monitorFileCleanupTask(task.taskId, task));
    }

    function monitorFileCleanupTask(taskId, initialTask) {
        if (fileCleanupTaskTimer) {
            clearTimeout(fileCleanupTaskTimer);
            fileCleanupTaskTimer = null;
        }
        fileCleanupTaskRunning = true;
        setCleanupActionButtonsDisabled(true);
        document.getElementById("file-cleanup-task").hidden = false;

        const poll = task => {
            if (task) {
                const progress = Math.max(0, Math.min(100, Number(task.progress || 0)));
                fileCleanupTaskProgress.option("value", progress);
                document.getElementById("file-cleanup-task-percent").textContent = `${progress}%`;
                document.getElementById("file-cleanup-task-message").textContent =
                    task.error || task.message || "背景作業處理中…";

                if (task.status === "Succeeded" || task.status === "Failed") {
                    fileCleanupTaskRunning = false;
                    setCleanupActionButtonsDisabled(false);
                    updateCleanupSelectionActions();
                    DevExpress.ui.notify(
                        task.error || task.message || (task.status === "Succeeded" ? "背景清理完成。" : "背景清理失敗。"),
                        task.status === "Succeeded" ? "success" : "error",
                        5000);
                    if (!document.getElementById("file-cleanup-panel").hidden)
                        loadCleanupItems();
                    return;
                }
            }

            fileCleanupTaskTimer = setTimeout(() => {
                $.ajax({
                    url: `/api/FileManagement/FileCleanupTask?taskId=${encodeURIComponent(taskId)}`,
                    type: "GET",
                    headers: co.Data.Header
                }).done(poll).fail(() => {
                    fileCleanupTaskTimer = setTimeout(() => poll(), 3000);
                });
            }, task ? 1500 : 0);
        };
        poll(initialTask);
    }

    function restoreRecycleFile(item) {
        postFileAction("RestoreFromRecycleBin", item.id, "檔案已還原。");
    }

    async function restoreSelectedRecycleFiles() {
        const items = fileCleanupGrid.getSelectedRowsData();
        if (!items.length) return;
        const confirmed = await co.sweet.confirmAsync(
            "批次還原",
            `確定還原選取的 ${items.length} 筆項目嗎？`,
            "確定還原",
            "取消");
        if (!confirmed) return;
        postSelectedFileActions("RestoreFromRecycleBin", items, "選取項目已還原。");
    }

    async function deleteSelectedRecycleFiles() {
        const items = fileCleanupGrid.getSelectedRowsData();
        if (!items.length) return;
        const confirmed = await co.sweet.confirmAsync(
            "永久刪除／清除紀錄",
            `確定處理選取的 ${items.length} 筆項目嗎？此操作完成後無法復原。`,
            "確定處理",
            "取消");
        if (!confirmed) return;
        startPermanentlyDeleteBackgroundTask(items);
    }

    function startPermanentlyDeleteBackgroundTask(items) {
        setCleanupActionButtonsDisabled(true);
        $.ajax({
            url: "/api/FileManagement/StartPermanentlyDeleteSelected",
            type: "POST",
            contentType: "application/json",
            headers: co.Data.Header,
            data: JSON.stringify(items.map(item => item.id))
        }).done(result => {
            DevExpress.ui.notify("資源回收桶清理已排程，可離開此頁面。", "success", 3500);
            monitorFileCleanupTask(result.taskId);
        }).fail(xhr => {
            setCleanupActionButtonsDisabled(false);
            updateCleanupSelectionActions();
            DevExpress.ui.notify(getFileActionError(xhr, "無法啟動資源回收桶清理。"), "error", 4500);
        });
    }

    async function permanentlyDeleteFile(item) {
        const message = item.isQuarantined
            ? `永久刪除「${escapeFileHtml(item.name)}」及其圖片組後無法復原，確定繼續嗎？`
            : `清除「${escapeFileHtml(item.name)}」的關聯還原紀錄後，原檔仍會保留供其他內容使用，但無法再還原本次移除的關聯。確定繼續嗎？`;
        const confirmed = await co.sweet.confirmAsync(
            item.isQuarantined ? "永久刪除檔案" : "清除還原紀錄",
            message,
            item.isQuarantined ? "確定刪除" : "確定清除",
            "取消");
        if (!confirmed) return;
        postFileAction(
            "PermanentlyDelete",
            item.id,
            item.isQuarantined ? "檔案已永久刪除。" : "關聯還原紀錄已清除。");
    }

    async function postSelectedFileActions(action, items, successMessage) {
        setCleanupActionButtonsDisabled(true);
        let completedCount = 0;
        try {
            for (const item of items) {
                await $.ajax({
                    url: `/api/FileManagement/${action}`,
                    type: "POST",
                    contentType: "application/json",
                    headers: co.Data.Header,
                    data: JSON.stringify(item.id)
                });
                completedCount++;
            }
            DevExpress.ui.notify(`${successMessage}（${completedCount} 筆）`, "success", 3000);
        } catch (xhr) {
            const progress = completedCount ? `已完成 ${completedCount} 筆；` : "";
            DevExpress.ui.notify(
                progress + getFileActionError(xhr, "批次檔案操作失敗。"),
                "error",
                4500);
        } finally {
            setCleanupActionButtonsDisabled(false);
            loadCleanupItems();
        }
    }

    function setCleanupActionButtonsDisabled(disabled) {
        [
            "file-cleanup-scan",
            "file-cleanup-recycle-selected",
            "file-cleanup-restore-selected",
            "file-cleanup-delete-selected",
            "file-cleanup-refresh"
        ].forEach(id => cleanupButton(id).option("disabled", disabled));
    }

    function postFileAction(action, id, successMessage) {
        $.ajax({
            url: `/api/FileManagement/${action}`,
            type: "POST",
            contentType: "application/json",
            headers: co.Data.Header,
            data: JSON.stringify(id)
        }).done(() => {
            DevExpress.ui.notify(successMessage, "success", 2500);
            loadCleanupItems();
        }).fail(xhr => {
            DevExpress.ui.notify(getFileActionError(xhr, "檔案操作失敗。"), "error", 4000);
        });
    }

    function getFileActionError(xhr, fallback) {
        return xhr?.responseJSON?.message || xhr?.responseText || fallback;
    }

    function escapeFileHtml(value) {
        return String(value || "").replace(/[&<>"']/g, character => ({
            "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;"
        })[character]);
    }

    function formatFileSize(size) {
        const bytes = Number(size || 0);
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
        return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
    }

    function formatFileDate(value) {
        return value ? new Date(value).toLocaleString("zh-TW") : "—";
    }
</script>
