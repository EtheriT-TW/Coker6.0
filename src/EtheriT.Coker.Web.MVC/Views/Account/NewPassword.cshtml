    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "輸入新密碼";
}
<link rel="stylesheet" href="~/css/Account/login.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Account/account-setup.css" asp-append-version="true" />
<script src="~/js/Account/Index.js" asp-append-version="true"></script>
<div class="row align-items-center justify-content-center align-items-center">
    <div class="col-md-12">
        <div class="form-block mx-auto account-setup-card">
            <div class="text-center setup-heading">
                <h3 class="text-uppercase">@ViewData["Title"]</h3>
                <p>設定完成後，即可登入網站管理後台。</p>
            </div>
            <form id="resetPasswordForm">
                <div id="accountSetupFields" class="mb-3" hidden>
                    <label for="setupAccount" class="setup-label">登入帳號 <span class="setup-tag">僅設定一次</span></label>
                    <input id="setupAccount" class="form-control" type="text" autocomplete="username" minlength="4" maxlength="50" pattern="[A-Za-z][A-Za-z0-9._-]{3,49}" aria-describedby="accountAvailability accountFormatHint">
                    <div id="accountAvailability" role="status" aria-live="polite"></div>
                    <details class="setup-help" id="accountFormatHint">
                        <summary>帳號格式說明</summary>
                        <p>4–50 碼，以英文字母開頭，可使用英文、數字、點（.）、底線（_）及連字號（-）。帳號須唯一，設定後不可變更。</p>
                    </details>
                </div>
                <div class="setup-password-heading">
                    <span class="setup-label">後台密碼</span>
                    <p>與前台會員密碼獨立，不會影響前台登入。</p>
                </div>
                <div class="form-floating mb-3">
                    <input id="newpassword" class="form-control pe-5" type="password" placeholder="密碼" autocomplete="new-password" required>
                    <label for="newpassword" class="form-label">設定新密碼</label>
                    <span class="fas fa-eye-slash position-absolute top-50 end-0 translate-middle-y me-3 toggle-password" id="togglePassword2" data-target="#newpassword"></span>
                </div>
                <div class="form-floating mb-3">
                    <input id="agnewpassword" class="form-control pe-5" type="password" placeholder="確認密碼" autocomplete="new-password" aria-describedby="passwordMatchStatus" required>
                    <label for="agnewpassword" class="form-label">確認密碼</label>
                    <span class="fas fa-eye-slash position-absolute top-50 end-0 translate-middle-y me-3 toggle-password" id="togglePassword3" data-target="#agnewpassword"></span>
                </div>
                <div id="passwordMatchStatus" class="password-match-status" role="status" aria-live="polite" hidden></div>
                <div id="rule">
                    <h4>密碼規則</h4>
                    <p id="length" class="invalid">長度 8–32 碼</p>
                    <div class="password-categories">
                        <p id="lowercase" class="invalid">小寫英文</p>
                        <p id="uppercase" class="invalid">大寫英文</p>
                        <p id="number" class="invalid">數字</p>
                        <p id="symbol" class="invalid">符號</p>
                    </div>
                    <p id="composition" class="invalid" aria-live="polite">四類中至少符合三類（目前 0／4）</p>
                </div>
                <div id="short-rule">
                    <p>8–32 碼；大小寫英文、數字、符號，任選至少三類。</p>
                </div>
                <input type="submit" value="確認送出" class="btn btn-block py-2 btn-primary" id="subnewpsw">
                <div class="setup-back-link">
                    <span class="ml-auto">
                        <a class="forgot-pass" asp-area="" asp-controller="Account" asp-action="Index">回到登入頁</a>
                    </span>
                </div>
            </form>
        </div>
    </div>
</div>
